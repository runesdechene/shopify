{%- doc -%}
  Renders mega menu list markup and optional featured content.

  @param {object} parent_link - The linklist to render.
  @param {string} id - Unique ID to assign to the `<ul>` element.
  @param {number} [grid_columns_count] - Number of grid columns for the mega menu.
  @param {number} [grid_columns_count_tablet] - Number of grid columns for the mega menu on tablets.
  @param {number} [grid_columns_count_collection_images] - Number of grid columns when `menu_content_type` is 'collection_images'.
  @param {string} [menu_content_type] - Type of content: 'featured_products', 'featured_collections', 'collection_images', or 'text'.
  @param {number} [content_aspect_ratio] - Aspect ratio for content images.
  @param {number} [image_border_radius] - Border radius for content images.
  @param {object} [section] - The section object.

  @example
  {% render 'mega-menu-list', parent_link: link, id: 'MegaMenuList-1', grid_columns_count: 6, menu_content_type: 'featured_products' %}
{%- enddoc -%}

{% liquid
  comment
    open_column_span tracks when a vertical column in the mega menu is open. Links will be stacked
    in the column until the code closes the column span.
  endcomment
  assign open_column_span = false
  assign column_count = 0
  assign links_before_wrap = 10
  assign max_menu_columns = grid_columns_count | default: 6
  assign max_menu_columns_tablet = grid_columns_count_tablet | default: 4

  # Parse icon mapping
  assign icon_map = ''
  if menu_icons_mapping != blank
    assign icon_lines = menu_icons_mapping | newline_to_br | split: '<br />'
    for line in icon_lines
      if line contains '|'
        assign parts = line | split: '|'
        assign link_name = parts[0] | strip
        assign icon_name = parts[1] | strip
        assign icon_map = icon_map | append: link_name | append: '::' | append: icon_name | append: '||'
      endif
    endfor
  endif

  # Parse column 2 links (newline-separated list of link titles)
  assign col2_list = ''
  assign has_column2 = false
  if column2_links != blank
    assign col2_lines = column2_links | newline_to_br | split: '<br />'
    for line in col2_lines
      assign clean_line = line | strip
      if clean_line != ''
        assign col2_list = col2_list | append: '||' | append: clean_line | append: '||'
        assign has_column2 = true
      endif
    endfor
  endif

  # Parse hot links (badge 🔥 HOT)
  assign hot_list = ''
  if hot_links != blank
    assign hot_lines = hot_links | newline_to_br | split: '<br />'
    for line in hot_lines
      assign clean_line = line | strip
      if clean_line != ''
        assign hot_list = hot_list | append: '||' | append: clean_line | append: '||'
      endif
    endfor
  endif

  # Parse column 3 links
  assign col3_list = ''
  assign has_column3 = false
  if column3_links != blank
    assign col3_lines = column3_links | newline_to_br | split: '<br />'
    for line in col3_lines
      assign clean_line = line | strip
      if clean_line != ''
        assign col3_list = col3_list | append: '||' | append: clean_line | append: '||'
        assign has_column3 = true
      endif
    endfor
  endif

  # Track whether column 1 title has been rendered
  assign col1_title_rendered = false

  ##
  # We only eager load heavy elements of the page when rendering this template
  # through the Section Rendering API.
  #
  # This keeps the initial render lightweight, minimizing the impact on TTFB.
  # The second render then refreshes the page with additional content.
  #
  # At the moment, we check if the Section Rendering API is being used by
  # checking if section.index is blank.
  assign eager_loading = false
  if section.index == blank
    assign eager_loading = true
  endif

  if menu_content_type == 'collection_images'
    assign collection_links = parent_link.links | where: 'type', 'collection_link'
    assign catalog_links = parent_link.links | where: 'type', 'catalog_link'
    assign collection_list_links = parent_link.links | where: 'type', 'collections_link'
    if collection_links.size == 0 and catalog_links.size == 0 and collection_list_links.size == 0
      assign menu_content_type = 'text'
    endif
  endif

  if menu_content_type == 'featured_collections'
    if parent_link.type == 'collection_link'
      assign collection_handles = parent_link.object.handle | append: ','
    elsif parent_link.type == 'catalog_link' or parent_link.type == 'collections_link'
      assign collection_handles = 'all' | append: ','
    endif
    assign collection_links = parent_link.links | where: 'type', 'collection_link'
    for collection_link in collection_links
      assign collection_handles = collection_handles | append: collection_link.object.handle | append: ','
    endfor
  endif

  if menu_content_type == 'featured_products'
    if parent_link.type == 'collection_link'
      assign collection_object = parent_link.object
    elsif parent_link.type == 'catalog_link' or parent_link.type == 'collections_link'
      assign collection_object = collections.all
    else
      assign menu_content_type = 'text'
    endif
  endif
%}
<ul
  data-menu-list-id="{{ id }}"
  class="mega-menu__list list-unstyled{% if has_column2 or has_column3 %} mega-menu__list--has-columns{% endif %}{% if menu_content_type == 'collection_images' %} rdc-menu-images{% endif %}"
  style="--menu-image-border-radius: {{ image_border_radius }}px;"
>
  {% for link in parent_link.links %}
    {% liquid
      # Si ce lien est dans la colonne 2, on le saute ici (rendu plus bas)
      assign is_col2_link = false
      assign is_col3_link = false
      if has_column2
        assign col2_check = '||' | append: link.title | append: '||'
        if col2_list contains col2_check
          assign is_col2_link = true
        endif
      endif
      if has_column3
        assign col3_check = '||' | append: link.title | append: '||'
        if col3_list contains col3_check
          assign is_col3_link = true
        endif
      endif
    %}
    {% if is_col2_link or is_col3_link %}{% continue %}{% endif %}
    {% liquid
      # Decide whether to open a column span, and how many columns of the grid to span
      if forloop.first or open_column_span == false
        assign open_column_span = true

        # Don't allow orphan links in a column
        assign break_after_modulo = link.links.size | modulo: links_before_wrap
        if break_after_modulo == 1
          assign links_before_wrap = links_before_wrap | minus: 1
        endif
        assign break_after_float = links_before_wrap | times: 1.0
        assign column_span = link.links.size | divided_by: break_after_float | ceil | at_least: 1
        assign column_count = column_count | plus: column_span
        assign should_break_columns = true

        if menu_content_type == 'collection_images'
          assign should_break_columns = false
          # For collection image mode, we have an 8-column grid when 4 or fewer parent links are used. Set column span to 2 in that case, otherwise use 1 column
          if parent_link.links.size <= 4
            assign span_class = 'mega-menu__column--wide-collection-image'
          else
            assign span_class = 'mega-menu__column--span-1'
          endif
        else
          # For all other modes, column span is determined by the number of links in the parent link
          assign span_class = 'mega-menu__column--span-' | append: column_span
        endif
        echo '<li class="mega-menu__column ' | append: span_class | append: '">'
      endif
    %}
    {%- if col1_title_rendered == false and column1_title != blank -%}
      {%- if has_column2 or has_column3 -%}
        <span class="mega-menu__col2-title">{{ column1_title }}</span>
        {%- assign col1_title_rendered = true -%}
      {%- endif -%}
    {%- endif -%}
    <div data-link-type="{{ link.type }}">
      <a
        href="{{ link.url }}"
        class="mega-menu__link {% if link.links != blank %}mega-menu__link--parent{% endif %}"
      >
        {% if menu_content_type == 'collection_images' %}
          {%- capture collection_image_sizes -%}
            {%- if parent_link.links.size <= 4 -%}
              {%- assign columns_per_item = 2 -%}
            {%- else -%}
              {%- assign columns_per_item = 1 -%}
            {%- endif -%}
            {%- render 'util-mega-menu-img-sizes-attr',
              menu_content_type: 'collection_images',
              settings: settings,
              grid_columns: grid_columns_count,
              grid_columns_tablet: grid_columns_count_tablet,
              grid_columns_collection_images: grid_columns_count_collection_images,
              parent_links_size: parent_link.links.size,
              columns_per_item: columns_per_item
            -%}
          {%- endcapture -%}

          {% render 'link-featured-image', link: link, class: 'mega-menu__link-image', sizes: collection_image_sizes %}
        {% endif %}
        
        {%- liquid
          comment
            ⚠ PRIORITE INVERSEE le 11/08 : la correspondance manuelle passe
            AVANT l'image de collection, alors qu'elle n'en etait que le repli.

            Pourquoi : une entree de menu qui pointe vers une collection dont
            l'image sert ailleurs — « Tout voir » vers « tous les produits »,
            dont l'image alimente aussi le hero de sa page — ne pouvait pas
            avoir sa propre vignette. Changer l'image de collection pour
            arranger le menu cassait la page.

            Desormais : pas de ligne dans la correspondance, l'image de
            collection s'affiche comme avant ; une ligne `Libelle|fichier.png`,
            elle gagne, et uniquement pour cette entree.

            Format : un `Libelle exact du lien|fichier.png` par ligne, dans le
            reglage du bloc de menu. Le fichier doit etre un ASSET DU THEME.
          endcomment

          comment
            PRIORITE 0 — le metachamp `custom.icon_menu` de la collection.

            C'est la bonne place : l'icone vit avec la collection, comme son
            image, et se change dans la fiche de la collection sans toucher ni
            au theme ni a un reglage a tenir a jour.

            ⚠ Double acces `.value` puis direct : selon le type du metachamp
            (image ou fichier), Shopify renvoie l'un ou l'autre. Ne pas
            simplifier — c'est le meme piege que sur les metaobjets
            d'illustration.
          endcomment
          assign menu_icon_mf = nil
          if link.object.metafields.custom.icon_menu != blank
            assign menu_icon_mf = link.object.metafields.custom.icon_menu.value | default: link.object.metafields.custom.icon_menu
          endif

          # Priorite 1 : correspondance manuelle, si une ligne vise ce lien
          assign current_icon = ''
          if menu_icon_mf == nil and icon_map != blank
            assign icon_entries = icon_map | split: '||'
            for entry in icon_entries
              if entry contains '::'
                assign entry_parts = entry | split: '::'
                assign entry_name = entry_parts[0] | strip
                assign entry_icon = entry_parts[1] | strip
                if entry_name == link.title
                  assign current_icon = entry_icon
                  break
                endif
              endif
            endfor
          endif

          # Priorite 2 : image de la collection liee
          assign link_collection_image = nil
          if menu_icon_mf == nil and current_icon == blank and link.type == 'collection_link' and link.object.image != blank
            assign link_collection_image = link.object.image
          endif
        -%}
        
        <span
          class="mega-menu__link-title wrap-text"
        >
          {%- if menu_icon_mf -%}
            <span class="mega-menu__link-icon">
              <img src="{{ menu_icon_mf | image_url: width: 64 }}" alt="{{ link.title }}"
                   width="32" height="32" loading="lazy">
            </span>
          {%- elsif current_icon != blank -%}
            <span class="mega-menu__link-icon">
              <img src="{{ current_icon | asset_url }}" alt="{{ link.title }}"
                   width="32" height="32" loading="lazy">
            </span>
          {%- elsif link_collection_image -%}
            <span class="mega-menu__link-icon">
              <img src="{{ link_collection_image | image_url: width: 64 }}" alt="{{ link.title }}"
                   width="32" height="32" loading="lazy">
            </span>
          {%- endif -%}
          {{- link.title -}}
          {%- if hot_list != blank -%}{%- assign hot_check = '||' | append: link.title | append: '||' -%}{%- if hot_list contains hot_check -%}<span class="mega-menu__hot-badge">🔥 HOT</span>{%- endif -%}{%- endif -%}
        </span>
        {%- comment -%}
          La ligne de contexte sous le nom, en mode grandes images seulement.

          ⚠ Elle vient d'abord du metachamp `custom.resume` de la collection :
          la description est un texte de PAGE, long et generique, qui fait une
          accroche de menu deplorable.

          Repli sur la description quand le resume est vide — mieux vaut une
          phrase imparfaite qu'un trou sous le nom.

          Double acces `.value` puis direct : selon le type du metachamp,
          Shopify renvoie l'un ou l'autre.
        {%- endcomment -%}
        {%- if menu_content_type == 'collection_images' and link.type == 'collection_link' -%}
          {%- assign resume_mf = link.object.metafields.custom.resume.value | default: link.object.metafields.custom.resume -%}
          {%- assign accroche = resume_mf | strip_html | strip -%}
          {%- if accroche == blank -%}
            {%- assign accroche = link.object.description | strip_html | strip -%}
          {%- endif -%}
          {%- if accroche != blank -%}
            <span class="mega-menu__link-lede">{{ accroche | truncate: 80 }}</span>
          {%- endif -%}
        {%- endif -%}
      </a>
      {% if link.links != blank %}
        <ul
          class="list-unstyled"
          {% if should_break_columns %}
            style="column-count: {{ column_span }};"
          {% endif %}
        >
          {% for childLink in link.links %}
            {%- liquid
              # Priority 1: Collection image
              assign child_collection_image = nil
              if childLink.type == 'collection_link' and childLink.object.image != blank
                assign child_collection_image = childLink.object.image
              endif

              # Priority 2: Manual icon mapping (fallback)
              assign child_icon = ''
              if child_collection_image == nil and icon_map != blank
                assign icon_entries = icon_map | split: '||'
                for entry in icon_entries
                  if entry contains '::'
                    assign entry_parts = entry | split: '::'
                    assign entry_name = entry_parts[0] | strip
                    assign entry_icon = entry_parts[1] | strip
                    if entry_name == childLink.title
                      assign child_icon = entry_icon
                      break
                    endif
                  endif
                endfor
              endif
            -%}
            
            {% assign break_after_modulo = forloop.index | modulo: links_before_wrap %}
            <li
              {% if break_after_modulo == 0 and should_break_columns %}
                style="break-after: column;"
              {% endif %}
            >
              <a
                href="{{ childLink.url }}"
                class="mega-menu__link"
              >
                <span class="mega-menu__link-title wrap-text">
                  {%- if child_collection_image -%}
                    <span class="mega-menu__link-icon">
                      <img src="{{ child_collection_image | image_url: width: 64 }}" alt="{{ childLink.title }}" loading="lazy">
                    </span>
                  {%- elsif child_icon != blank -%}
                    <span class="mega-menu__link-icon">
                      <img src="{{ child_icon | asset_url }}" alt="{{ childLink.title }}" loading="lazy">
                    </span>
                  {%- endif -%}
                  {{- childLink.title -}}
                  {%- if hot_list != blank -%}{%- assign hot_check = '||' | append: childLink.title | append: '||' -%}{%- if hot_list contains hot_check -%}<span class="mega-menu__hot-badge">🔥 HOT</span>{%- endif -%}{%- endif -%}
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    {% liquid
      # Check conditions for closing the span at the end of each iteration, then close the span if needed
      assign next_linklist = parent_link.links[forloop.index]

      if forloop.last
        assign open_column_span = false
      elsif menu_content_type == 'collection_images'
        assign open_column_span = false
      elsif next_linklist.links != blank
        assign open_column_span = false
      elsif link.links != blank and next_linklist.links == blank
        assign open_column_span = false
      endif

      if open_column_span == false
        echo '</li>'
      endif
    %}
  {% endfor %}

  {%- comment -%} Colonne 2 : liens configurés dans le schema {%- endcomment -%}
  {% if has_column2 %}
    <li class="mega-menu__column mega-menu__column--col2">
      {% if column2_title != blank %}
        <span class="mega-menu__col2-title">{{ column2_title }}</span>
      {% endif %}
      {% for link in parent_link.links %}
        {%- assign col2_check = '||' | append: link.title | append: '||' -%}
        {% if col2_list contains col2_check %}
          <div data-link-type="{{ link.type }}">
            <a href="{{ link.url }}" class="mega-menu__link">
              {%- liquid
                assign menu_icon_mf = nil
                if link.object.metafields.custom.icon_menu != blank
                  assign menu_icon_mf = link.object.metafields.custom.icon_menu.value | default: link.object.metafields.custom.icon_menu
                endif

                assign link_collection_image = nil
                if menu_icon_mf == nil and link.type == 'collection_link' and link.object.image != blank
                  assign link_collection_image = link.object.image
                endif

                assign current_icon = ''
                if menu_icon_mf == nil and link_collection_image == nil and icon_map != blank
                  assign icon_entries = icon_map | split: '||'
                  for entry in icon_entries
                    if entry contains '::'
                      assign entry_parts = entry | split: '::'
                      assign entry_name = entry_parts[0] | strip
                      assign entry_icon = entry_parts[1] | strip
                      if entry_name == link.title
                        assign current_icon = entry_icon
                        break
                      endif
                    endif
                  endfor
                endif
              -%}
              <span class="mega-menu__link-title wrap-text">
                {%- if menu_icon_mf -%}
                  <span class="mega-menu__link-icon">
                    <img src="{{ menu_icon_mf | image_url: width: 64 }}" alt="{{ link.title }}"
                         width="24" height="24" loading="lazy">
                  </span>
                {%- elsif link_collection_image -%}
                  <span class="mega-menu__link-icon">
                    <img src="{{ link_collection_image | image_url: width: 64 }}" alt="{{ link.title }}"
                         width="24" height="24" loading="lazy">
                  </span>
                {%- elsif current_icon != blank -%}
                  <span class="mega-menu__link-icon">
                    <img src="{{ current_icon | asset_url }}" alt="{{ link.title }}" loading="lazy">
                  </span>
                {%- endif -%}
                {{- link.title -}}
              </span>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </li>
  {% endif %}

  {%- comment -%} Colonne 3 : liens configurés dans le schema {%- endcomment -%}
  {% if has_column3 %}
    <li class="mega-menu__column mega-menu__column--col2">
      {% if column3_title != blank %}
        <span class="mega-menu__col2-title">{{ column3_title }}</span>
      {% endif %}
      {% for link in parent_link.links %}
        {%- assign col3_check = '||' | append: link.title | append: '||' -%}
        {% if col3_list contains col3_check %}
          <div data-link-type="{{ link.type }}">
            <a href="{{ link.url }}" class="mega-menu__link">
              {%- liquid
                assign menu_icon_mf = nil
                if link.object.metafields.custom.icon_menu != blank
                  assign menu_icon_mf = link.object.metafields.custom.icon_menu.value | default: link.object.metafields.custom.icon_menu
                endif

                assign link_collection_image = nil
                if menu_icon_mf == nil and link.type == 'collection_link' and link.object.image != blank
                  assign link_collection_image = link.object.image
                endif

                assign current_icon = ''
                if menu_icon_mf == nil and link_collection_image == nil and icon_map != blank
                  assign icon_entries = icon_map | split: '||'
                  for entry in icon_entries
                    if entry contains '::'
                      assign entry_parts = entry | split: '::'
                      assign entry_name = entry_parts[0] | strip
                      assign entry_icon = entry_parts[1] | strip
                      if entry_name == link.title
                        assign current_icon = entry_icon
                        break
                      endif
                    endif
                  endfor
                endif
              -%}
              <span class="mega-menu__link-title wrap-text">
                {%- if menu_icon_mf -%}
                  <span class="mega-menu__link-icon">
                    <img src="{{ menu_icon_mf | image_url: width: 64 }}" alt="{{ link.title }}"
                         width="24" height="24" loading="lazy">
                  </span>
                {%- elsif link_collection_image -%}
                  <span class="mega-menu__link-icon">
                    <img src="{{ link_collection_image | image_url: width: 64 }}" alt="{{ link.title }}"
                         width="24" height="24" loading="lazy">
                  </span>
                {%- elsif current_icon != blank -%}
                  <span class="mega-menu__link-icon">
                    <img src="{{ current_icon | asset_url }}" alt="{{ link.title }}" loading="lazy">
                  </span>
                {%- endif -%}
                {{- link.title -}}
              </span>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </li>
  {% endif %}
</ul>

{% liquid
  # decide how many grid columns are needed for the menu list, and how many columns are needed for the featured content
  # prioritize a minimum of 1 featured_collection (2 columns), and minimum 2 featured_products (2 columns)
  assign min_products = 2
  assign max_products = 3
  assign min_products_tablet = 1
  assign max_products_tablet = 3
  assign min_collections = 1

  if menu_content_type == 'featured_products'
    # desktop breakpoint
    assign temp_column_count = column_count | plus: min_products

    if temp_column_count > max_menu_columns
      assign max_product_columns = 2
    else
      assign max_product_columns = max_menu_columns | minus: column_count | at_most: max_products
    endif

    if eager_loading
      assign max_product_columns = max_product_columns | at_most: collection_object.products_count
    else
      assign max_product_columns = 0
    endif

    assign max_featured_products = max_product_columns
    assign max_menu_columns = max_menu_columns | minus: max_product_columns

    # tablet breakpoint
    assign temp_column_count = column_count | plus: min_products_tablet

    if temp_column_count > max_menu_columns_tablet
      assign max_product_columns_tablet = 1
    else
      assign max_product_columns_tablet = max_menu_columns_tablet | minus: column_count | at_most: max_products_tablet
    endif

    assign max_product_columns_tablet = max_product_columns_tablet | at_most: max_product_columns

    assign max_featured_products_tablet = max_product_columns_tablet
    assign max_menu_columns_tablet = max_menu_columns_tablet | minus: max_product_columns_tablet
  endif

  if menu_content_type == 'featured_collections'
    # desktop breakpoint
    assign min_featured_collection_columns = min_collections | times: 2
    assign temp_column_count = column_count | plus: min_featured_collection_columns

    if temp_column_count > max_menu_columns
      assign max_collection_columns = 2
    else
      assign max_collection_columns = max_menu_columns | minus: column_count
    endif

    assign max_featured_collections = max_collection_columns | divided_by: 2 | floor
    assign max_menu_columns = max_menu_columns | minus: max_collection_columns

    # tablet breakpoint
    assign max_collection_columns_tablet = 2
    assign max_featured_collections_tablet = 1
    assign max_menu_columns_tablet = max_menu_columns_tablet | minus: max_collection_columns_tablet
  endif
%}

{% style %}
  [data-menu-grid-id="{{ id }}"] {
    {% if menu_content_type == 'collection_images' and parent_link.links.size < 5 %}
      --menu-columns-desktop: {{ grid_columns_count_collection_images }};
      --menu-columns-tablet: {{ grid_columns_count_tablet }};
    {% else %}
      --menu-columns-desktop: {{ grid_columns_count }};
      --menu-columns-tablet: {{ grid_columns_count_tablet }};
    {% endif %}
  }

  [data-menu-list-id="{{ id }}"] {
    {% if menu_content_type == 'collection_images' and parent_link.links.size < 5 %}
      --menu-columns-desktop: {{ grid_columns_count_collection_images }};
      --menu-columns-tablet: {{ max_menu_columns_tablet }};
    {% else %}
      --menu-columns-desktop: {{ max_menu_columns }};
      --menu-columns-tablet: {{ max_menu_columns_tablet }};
    {% endif %}
  }
{% endstyle %}

{% case menu_content_type %}
  {% when 'featured_products' %}
    {%- capture image_sizes -%}
      {%- render 'util-mega-menu-img-sizes-attr',
        menu_content_type: 'featured_products',
        settings: settings,
        grid_columns: grid_columns_count,
        grid_columns_tablet: grid_columns_count_tablet
      -%}
    {%- endcapture -%}

    <span
      class="mega-menu__content"
      style="--menu-content-columns-desktop: {{ max_product_columns }}; --menu-content-columns-tablet: {{ max_product_columns_tablet }}; --resource-card-corner-radius: {{ image_border_radius }}px;"
    >
      <ul
        class="mega-menu__content-list mega-menu__content-list--products list-unstyled"
      >
        {% if eager_loading %}
          {% paginate collection_object.products by max_featured_products %}
            {% for item in collection_object.products %}
              <li class="mega-menu__content-list-item {% if forloop.index > max_featured_products_tablet %} mega-menu__content-list-item--hidden-tablet{% endif %}">
                {% render 'resource-card',
                  resource: item,
                  resource_type: 'product',
                  image_hover: true,
                  image_aspect_ratio: content_aspect_ratio,
                  image_sizes: image_sizes
                %}
              </li>
            {% endfor %}
          {% endpaginate %}
        {% endif %}
      </ul>
    </span>
  {% when 'featured_collections' %}
    {% assign collection_handles = collection_handles | split: ',' | uniq %}
    {%- capture image_sizes -%}
      {%- render 'util-mega-menu-img-sizes-attr',
        menu_content_type: 'featured_collections',
        settings: settings
      -%}
    {%- endcapture -%}

    {% if collection_handles.size == 1 %}
      {% assign max_featured_collections = 1 %}
    {% endif %}

    <span
      class="mega-menu__content"
      style="--menu-content-columns-desktop: {{ max_collection_columns }}; --menu-content-columns-tablet: {{ max_collection_columns_tablet }}; --resource-card-corner-radius: {{ image_border_radius }}px;"
    >
      <ul
        class="mega-menu__content-list mega-menu__content-list--collections list-unstyled"
        style="--menu-content-columns-desktop: {{ max_featured_collections }}; --menu-content-columns-tablet: {{ max_featured_collections_tablet }};"
      >
        {% for handle in collection_handles limit: max_featured_collections %}
          {% if handle == 'all' %}
            {% assign collection_object = collections.all %}
          {% else %}
            {% assign collection_object = collections[handle] %}
          {% endif %}
          <li class="mega-menu__content-list-item{% if forloop.index > max_featured_collections_tablet %} mega-menu__content-list-item--hidden-tablet{% endif %}">
            {% render 'resource-card',
              resource: collection_object,
              resource_type: 'collection',
              style: 'overlay',
              image_aspect_ratio: content_aspect_ratio,
              image_sizes: image_sizes
            %}
          </li>
        {% endfor %}
      </ul>
    </span>
{% endcase %}

{% stylesheet %}
  /* ---------------------------------------------------------------------------
   * LE FOND BLANC DES ICONES DE MENU
   *
   * Verifie le 11/08 : les PNG d'icone n'ont PAS de canal alpha — leur fond
   * blanc est cuit dans l'image. Le theme, lui, ne peint rien derriere.
   *
   * `multiply` fait disparaitre le blanc sur un fond clair : le blanc multiplie
   * par le parchemin donne le parchemin, le trait sombre reste. C'est deja le
   * procede utilise pour le filigrane des pages motif.
   *
   * ⚠ Ne tient QUE sur fond clair. Si le menu passait un jour sur fond sombre,
   * les icones s'y noieraient — il faudrait alors de vrais PNG transparents.
   * C'est de toute facon la solution propre : reexporter les icones avec un
   * fond transparent rend cette regle inutile, et elle peut alors sauter.
   * ------------------------------------------------------------------------- */
  .mega-menu__link-icon img {
    mix-blend-mode: multiply;
  }

  /* ---------------------------------------------------------------------------
   * LE SECOND RANG DU MEGA-MENU
   *
   * Le bloc « colonne 2 » du theme sert desormais de RANGEE SECONDAIRE : les
   * collections listees dans son reglage passent SOUS les grandes, en
   * pastilles. La hierarchie se lit sans avoir a l'expliquer.
   *
   * Comment : des qu'une colonne 2 existe, le theme met la liste en rangee
   * flexible. On l'autorise a passer a la ligne, et on donne toute la largeur
   * au bloc secondaire — il tombe donc de lui-meme en dessous.
   *
   * ⚠ Le theme dessine un rectangle gris 16/9 devant tout lien sans image (un
   * emplacement d'illustration). Sur une pastille il n'a aucun sens : il est
   * neutralise ici, et seulement ici.
   * ------------------------------------------------------------------------- */
  .mega-menu__list--has-columns { flex-wrap: wrap; }

  .mega-menu__column--col2 {
    flex: 0 0 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(64, 52, 52, .13);
  }

  .mega-menu__column--col2 .mega-menu__col2-title {
    flex: 0 0 100%;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    opacity: .6;
    margin-bottom: 2px;
  }

  .mega-menu__column--col2 > div > .mega-menu__link,
  .mega-menu__column--col2 > div > .mega-menu__link:not(:has(.mega-menu__link-image)) {
    flex-direction: row;
    align-items: center;
    padding: 7px 14px 7px 9px;
    border: 1px solid rgba(64, 52, 52, .13);
    border-radius: 999px;
    transition: border-color .2s ease, background-color .2s ease;
  }

  .mega-menu__column--col2 > div > .mega-menu__link:hover {
    border-color: #b4894f;
    background-color: rgba(180, 137, 79, .08);
  }

  .mega-menu__column--col2 > div > .mega-menu__link:not(:has(.mega-menu__link-image))::before {
    content: none;
  }

  .mega-menu__column--col2 .mega-menu__link-title {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: .76rem;
    letter-spacing: .04em;
  }

  .mega-menu__column--col2 .mega-menu__link-icon img { width: 22px; height: 22px; }


  /* ---------------------------------------------------------------------------
   * LE RANG DES GRANDES IMAGES
   *
   * Le theme les rend brutes : collees les unes aux autres, rognees en bandeau
   * large, et le titre repete SOUS l'image avec une mini-vignette — alors que
   * l'image porte deja le nom. Quatre corrections :
   *   1. de l'air entre les cartes, et des coins arrondis comme partout ;
   *   2. un cadrage 4/3 au lieu du bandeau, qui coupait les titres peints
   *      dans les visuels ;
   *   3. la mini-vignette disparait quand une grande image est presente —
   *      elle n'a de sens que sur un lien sans image ;
   *   4. le nom passe en police de titrage, comme sur les cartes de saga.
   * ------------------------------------------------------------------------- */
  .mega-menu__column--wide-collection-image {
    padding-inline: 6px;
  }

  /* ⚠ La classe est posee SUR l'image par `link-featured-image`, pas sur un
   * conteneur : viser `.mega-menu__link-image img` ne touchait rien. C'est
   * pour ca que le cadrage en bandeau persistait. */
  img.mega-menu__link-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
  }

  .mega-menu__link-lede {
    display: block;
    font-family: var(--font-body--family);
    font-size: .78rem;
    line-height: 1.35;
    opacity: .72;
    margin-top: 3px;
  }

  /* 3. Une vignette a cote du nom, sous une grande image du meme sujet, ne dit
   *    rien de plus : elle encombre. */
  .mega-menu__link:has(.mega-menu__link-image) .mega-menu__link-icon {
    display: none;
  }

  /* 4. Le nom, en police de titrage. */
  .mega-menu__link:has(.mega-menu__link-image) .mega-menu__link-title {
    font-family: var(--font-heading--family, sans-serif);
    font-size: 1.3rem;
    letter-spacing: .03em;
    line-height: 1.05;
    text-transform: uppercase;
    margin-top: 9px;
    display: block;
  }


  /* ---------------------------------------------------------------------------
   * LE RANG DES GRANDES IMAGES — GRILLE IMPOSEE
   *
   * ⚠ Pourquoi on reprend la main : le theme calcule des largeurs de colonne
   * a partir du NOMBRE d'enfants du menu (span 2 si 4 ou moins, span 1 sinon).
   * Ajouter une collection secondaire fait donc changer la largeur de TOUTES
   * les grandes — d'ou des cartes de tailles differentes, et une carte qui
   * retrecit des qu'on ajoute une ligne ailleurs.
   *
   * On pose donc une grille a nous : quatre colonnes egales, alignees par le
   * haut. Les largeurs ne dependent plus du nombre d'entrees, et les hauteurs
   * d'image sont identiques puisque les largeurs le sont et que le cadrage est
   * fixe en 4/3.
   *
   * `!important` sur `grid-column` : les classes de span du theme sont posees
   * sur chaque colonne, et elles gagneraient sinon.
   * ------------------------------------------------------------------------- */
  .rdc-menu-images {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px 18px;
    align-items: start;
  }

  @media (max-width: 989px) {
    .rdc-menu-images { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .rdc-menu-images > .mega-menu__column {
    grid-column: auto !important;
    width: auto;
    padding-inline: 0;
  }

  /* La rangee secondaire traverse toute la grille, sous les grandes. */
  .rdc-menu-images > .mega-menu__column--col2,
  .rdc-menu-images > .mega-menu__column--col3 {
    grid-column: 1 / -1 !important;
  }

  /* ⚠ Le rectangle gris 16/9 que le theme dessine devant un lien sans image
   * doit etre neutralise en `!important` : sa regle vit dans la meme feuille
   * compilee que la notre et peut passer apres. Sans ca il devient un grand
   * ovale gris dans les pastilles — c'est ce qu'on voyait. */
  .rdc-menu-images .mega-menu__column--col2 .mega-menu__link::before,
  .rdc-menu-images .mega-menu__column--col3 .mega-menu__link::before {
    content: none !important;
  }

{% endstylesheet %}
