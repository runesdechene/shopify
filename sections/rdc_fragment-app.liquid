{% comment %}
  RDC — Fragment & App (fiche produit).
  Bloc app-unlock : le Fragment acheté s'active dans l'application La Carte.
  Gauche : ce que CE Fragment débloque (3 médaillons) + rappel de l'app (chips à icônes, blocs éditables, repris de rdc_app).
  Droite : téléphone (vidéo de l'app) + « Carte de Porteur » flottante (illustration + Titre-trophée).
  Titre dynamique via RPC Supabase anon get_fragment_unlocks_by_tag (tag produit fragment:xxx, fallback nom du Fragment si absent).
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign perso = product.metafields.custom.illustration_produit.value.nom
  assign illu = s.app_image
  if illu == blank
    assign illu = product.metafields.custom.illustration_produit.value.image_pour_fond_clair.value
  endif
  if illu == blank
    assign illu = product.featured_image
  endif
  assign poster_url = ''
  if s.video_poster != blank
    assign poster_url = s.video_poster | image_url: width: 720
  elsif s.app_video != blank and s.app_video.preview_image != blank
    assign poster_url = s.app_video.preview_image | image_url: width: 720
  endif
  assign unlock1_text = s.unlock1_desc
  assign unlock2_text = s.unlock2_desc
  if perso != blank
    assign unlock1_text = unlock1_text | replace: '[perso]', perso
    assign unlock2_text = unlock2_text | replace: '[perso]', perso
  else
    assign unlock1_text = unlock1_text | replace: '[perso]', 'ton personnage'
    assign unlock2_text = unlock2_text | replace: '[perso]', 'ton personnage'
  endif
  assign bridge_html = s.bridge | replace: '[joueurs]', '<span class="rdc-fa-stat" data-stat="joueurs">4 700</span>' | replace: '[lieux]', '<span class="rdc-fa-stat" data-stat="lieux">2 800</span>'
  assign frag_tag = ''
  for t in product.tags
    assign tp = t | slice: 0, 9
    if tp == 'fragment:' or tp == 'fragment-'
      assign frag_tag = t
      break
    endif
  endfor
  # Defaults Supabase (cle anon publique, protegee par RLS) : la section marche sans rien saisir, restent surchargeables
  assign supa_url = section.settings.supabase_url | default: 'https://ukpapqssgsxirsgmcvof.supabase.co'
  assign supa_key = section.settings.supabase_anon_key | default: 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVrcGFwcXNzZ3N4aXJzZ21jdm9mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAyOTU5OTMsImV4cCI6MjA4NTg3MTk5M30.Le1gdE3HhmZ2gzMJF9hVhlZVsILmLd5GQgk87xC_dUY'
-%}

