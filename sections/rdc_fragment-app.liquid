{% comment %}
  RDC — Fragment & App (fiche produit).
  Bloc app-unlock : le Fragment acheté s'active dans l'application La Carte.
  Gauche : ce que CE Fragment débloque (3 médaillons) + rappel de l'app (chips à icônes, blocs éditables, repris de rdc_app).
  Droite : téléphone (vidéo de l'app) + « Carte de Porteur » flottante (illustration + Titre-trophée).
  Titre dynamique via RPC Supabase anon get_fragment_unlocks_by_product (fallback générique si absente).
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign perso = product.metafields.custom.illustration_produit.value.nom
  assign illu = s.app_image
  if illu == blank
    assign illu = product.metafields.custom.illustration_produit.value.image_pour_fond_clair.value
  endif
  if illu == blank
    assign illu = product.featured_image
  endif
  assign poster_url = ''
  if s.video_poster != blank
    assign poster_url = s.video_poster | image_url: width: 720
  elsif s.app_video != blank and s.app_video.preview_image != blank
    assign poster_url = s.app_video.preview_image | image_url: width: 720
  endif
  assign unlock1_text = s.unlock1_desc
  assign unlock2_text = s.unlock2_desc
  if perso != blank
    assign unlock1_text = unlock1_text | replace: '[perso]', perso
    assign unlock2_text = unlock2_text | replace: '[perso]', perso
  else
    assign unlock1_text = unlock1_text | replace: '[perso]', 'ton personnage'
    assign unlock2_text = unlock2_text | replace: '[perso]', 'ton personnage'
  endif
  assign bridge_html = s.bridge | replace: '[joueurs]', '<span class="rdc-fa-stat" data-stat="joueurs">4 700</span>' | replace: '[lieux]', '<span class="rdc-fa-stat" data-stat="lieux">2 800</span>'
-%}

<style>
  .rdc-fa-{{ section.id }} { max-width: var(--page-content-width, 120rem); margin-inline: auto; padding: 1.5rem 0 3rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__card {
    background-color: #f5f1e8;
    {% if s.background_image %}background-image: url('{{ s.background_image | image_url: width: 1600 }}'); background-size: cover; background-position: center;{% endif %}
    border: 2px solid #ac9c89; border-radius: 20px; padding: 38px 42px;
  }
  @media (max-width: 749px) { .rdc-fa-{{ section.id }} .rdc-fa__card { padding: 28px 22px; } }
  .rdc-fa-{{ section.id }} .rdc-fa__layout { display: flex; gap: 32px; align-items: center; }
  @media (max-width: 900px) { .rdc-fa-{{ section.id }} .rdc-fa__layout { flex-direction: column; } }
  .rdc-fa-{{ section.id }} .rdc-fa__col { flex: 1; }
  .rdc-fa-{{ section.id }} .rdc-fa__pretitle { font-family: var(--font-accent--family); text-transform: uppercase; letter-spacing: .16em; font-size: .74rem; font-weight: 700; color: var(--color-primary, #833434); margin: 0 0 .3rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__title { font-family: var(--font-heading--family); font-size: clamp(2rem, 4vw, 2.6rem); line-height: .98; color: var(--color-foreground-heading, #403434); margin: 0 0 .45rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__bridge { font-family: var(--font-fragment--family); font-style: italic; font-size: 1.08rem; line-height: 1.4; color: var(--color-primary, #962B21); margin: 0 0 1rem; max-width: 36ch; }
  .rdc-fa-{{ section.id }} .rdc-fa-stat { font-style: normal; font-weight: 700; font-variant-numeric: tabular-nums; }

  .rdc-fa-{{ section.id }} .rdc-fa__lbl { font-family: var(--font-accent--family); text-transform: uppercase; letter-spacing: .12em; font-size: .72rem; font-weight: 700; color: var(--color-primary, #833434); margin: 0 0 .2rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__u { display: flex; gap: 12px; align-items: center; padding: 9px 0; border-bottom: 1px solid #e6d8bd; }
  .rdc-fa-{{ section.id }} .rdc-fa__u:last-of-type { border-bottom: none; }
  .rdc-fa-{{ section.id }} .rdc-fa__med { flex: 0 0 38px; height: 38px; border-radius: 50%; background: #efe2c6; border: 1.5px solid #ac9c89; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__ut { font-family: var(--font-accent--family); font-weight: 700; color: var(--color-foreground-heading, #403434); display: block; line-height: 1.1; }
  .rdc-fa-{{ section.id }} .rdc-fa__ud { font-family: var(--font-paragraph--family); color: var(--color-foreground, #594848); font-size: .86rem; }

  .rdc-fa-{{ section.id }} .rdc-fa__sep { height: 1px; background: #e0d3b8; margin: 16px 0 12px; }
  .rdc-fa-{{ section.id }} .rdc-fa__chips-heading { font-family: var(--font-accent--family); text-transform: uppercase; letter-spacing: .1em; font-size: .72rem; font-weight: 700; color: var(--color-foreground-heading, #403434); opacity: .7; margin: 0 0 .5rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__chips { display: flex; flex-wrap: wrap; gap: 7px; margin: 0 0 1rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__chip { display: inline-flex; align-items: center; gap: 6px; background: rgb(var(--color-foreground-rgb) / .05); border: 1px solid rgb(var(--color-foreground-rgb) / .18); border-radius: 999px; padding: 5px 11px; font-family: var(--font-accent--family); font-weight: 700; font-size: .74rem; letter-spacing: .04em; text-transform: uppercase; color: var(--color-foreground-heading, #403434); }
  .rdc-fa-{{ section.id }} .rdc-fa__chip svg { width: 14px; height: 14px; flex: 0 0 auto; color: var(--color-primary, #962B21); }

  .rdc-fa-{{ section.id }} .rdc-fa__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 1rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__free { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-accent--family); font-weight: 700; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-foreground-heading, #403434); background: var(--color-background, #fff); border: 1px solid rgb(var(--color-foreground-rgb) / .15); padding: 7px 13px; border-radius: 30px; }
  .rdc-fa-{{ section.id }} .rdc-fa__free .dot { width: 7px; height: 7px; border-radius: 50%; background: #39b35a; box-shadow: 0 0 0 4px rgba(57,179,90,.18); }
  .rdc-fa-{{ section.id }} .rdc-fa__cta { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-accent--family); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: .82rem; color: var(--color-primary, #833434); background: transparent; border: 1.5px solid var(--color-primary, #833434); padding: 9px 17px; border-radius: 8px; text-decoration: none; transition: background .18s ease, color .18s ease; }
  .rdc-fa-{{ section.id }} .rdc-fa__cta:hover { background: var(--color-primary, #833434); color: var(--color-background, #fff); }
  .rdc-fa-{{ section.id }} .rdc-fa__cta .arrow { transition: transform .18s ease; }
  .rdc-fa-{{ section.id }} .rdc-fa__cta:hover .arrow { transform: translateX(3px); }
  .rdc-fa-{{ section.id }} .rdc-fa__note { font-size: .83rem; opacity: .8; margin-top: .55rem; }

  /* Scène droite : téléphone héros + carte flottante */
  .rdc-fa-{{ section.id }} .rdc-fa__stage { flex: 0 0 44%; position: relative; display: flex; justify-content: flex-end; align-items: center; min-height: 380px; }
  .rdc-fa-{{ section.id }} .rdc-fa__phonewrap { position: relative; }
  .rdc-fa-{{ section.id }} .rdc-fa__phone { position: relative; z-index: 1; width: clamp(196px, 21vw, 240px); aspect-ratio: 300 / 610;
    background: #1a1410; border-radius: 36px; padding: 8px; box-shadow: 0 36px 72px -25px rgba(40,30,15,.5), 0 0 0 2px rgba(0,0,0,.25) inset; }
  .rdc-fa-{{ section.id }} .rdc-fa__screen { width: 100%; height: 100%; border-radius: 28px; overflow: hidden; background: #1a1410; }
  .rdc-fa-{{ section.id }} .rdc-fa__screen video, .rdc-fa-{{ section.id }} .rdc-fa__screen img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rdc-fa-{{ section.id }} .rdc-fa__screen-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; color: #e9dcc4; font-family: var(--font-paragraph--family); font-size: .8rem; padding: 20px; background: linear-gradient(135deg,#55584a,#2b2d23); }

  .rdc-fa-{{ section.id }} .rdc-fa__reward { position: absolute; right: calc(100% - 24px); bottom: 28px; z-index: 2; width: 212px; border-radius: 14px; padding: 12px; background: #46493c; box-shadow: 0 18px 36px rgba(0,0,0,.34); }
  .rdc-fa-{{ section.id }} .rdc-fa__reward--light { background: #ece2cd; box-shadow: 0 14px 28px rgba(131,52,52,.16); }
  .rdc-fa-{{ section.id }} .rdc-fa__reward-label { display: inline-block; background: #f4d694; color: #623c3c; font-family: var(--font-accent--family); font-weight: 700; font-size: .58rem; letter-spacing: .09em; text-transform: uppercase; padding: 3px 8px; border-radius: 20px; margin-bottom: 8px; }
  .rdc-fa-{{ section.id }} .rdc-fa__illu { aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; background: #efe6d3; display: flex; align-items: center; justify-content: center; }
  .rdc-fa-{{ section.id }} .rdc-fa__illu img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .rdc-fa-{{ section.id }} .rdc-fa__plaque { margin-top: 9px; border-radius: 8px; padding: 9px 11px; display: flex; align-items: center; gap: 9px; background: linear-gradient(#3c3f33,#33362b); border: 1px solid #6d6f54; }
  .rdc-fa-{{ section.id }} .rdc-fa__reward--light .rdc-fa__plaque { background: #fff8ec; border: 1px solid #d8ccb4; }
  .rdc-fa-{{ section.id }} .rdc-fa__seal { flex: 0 0 28px; height: 28px; border-radius: 50%; background: #f4d694; display: flex; align-items: center; justify-content: center; font-size: .9rem; }
  .rdc-fa-{{ section.id }} .rdc-fa__plaque small { display: block; font-family: var(--font-accent--family); text-transform: uppercase; letter-spacing: .1em; font-size: .52rem; color: #c7b06a; }
  .rdc-fa-{{ section.id }} .rdc-fa__reward--light .rdc-fa__plaque small { color: #9a6a1e; }
  .rdc-fa-{{ section.id }} .rdc-fa__plaque b { font-family: var(--font-heading--family); font-weight: 400; font-size: 1.05rem; color: #f6eddd; line-height: 1.05; }
  .rdc-fa-{{ section.id }} .rdc-fa__reward--light .rdc-fa__plaque b { color: #403434; }

  @media (max-width: 900px) {
    .rdc-fa-{{ section.id }} .rdc-fa__stage { flex: auto; justify-content: center; width: 100%; min-height: 0; margin-top: 8px; }
    .rdc-fa-{{ section.id }} .rdc-fa__phonewrap { display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .rdc-fa-{{ section.id }} .rdc-fa__phone { margin: 0 auto; }
    .rdc-fa-{{ section.id }} .rdc-fa__reward { position: static; width: 230px; margin: 0 auto; }
  }
  @media (prefers-reduced-motion: reduce) { .rdc-fa-{{ section.id }} .rdc-fa__screen video { display: none; } }
</style>

<div class="rdc-fa-{{ section.id }}" id="rdc-fa-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="rdc-fa__card">
    <div class="rdc-fa__layout">
      <div class="rdc-fa__col">
        {% if s.pretitle != blank %}<p class="rdc-fa__pretitle">{{ s.pretitle }}</p>{% endif %}
        <h2 class="rdc-fa__title">{{ s.title }}</h2>
        {% if s.bridge != blank %}<p class="rdc-fa__bridge">{{ bridge_html }}</p>{% endif %}

        {% if s.unlocks_label != blank %}<p class="rdc-fa__lbl">{{ s.unlocks_label }}</p>{% endif %}
        <div class="rdc-fa__u">
          <div class="rdc-fa__med">🏷️</div>
          <div><span class="rdc-fa__ut">{{ s.unlock1_title }}</span>
          <span class="rdc-fa__ud" id="rdc-fa-titre-{{ section.id }}">{{ unlock1_text }}</span></div>
        </div>
        <div class="rdc-fa__u">
          <div class="rdc-fa__med">🧩</div>
          <div><span class="rdc-fa__ut">{{ s.unlock2_title }}</span>
          <span class="rdc-fa__ud">{{ unlock2_text }}</span></div>
        </div>
        <div class="rdc-fa__u">
          <div class="rdc-fa__med">🗺️</div>
          <div><span class="rdc-fa__ut">{{ s.unlock3_title }}</span>
          <span class="rdc-fa__ud">{{ s.unlock3_desc }}</span></div>
        </div>

        <div class="rdc-fa__sep"></div>
        {% if s.chips_heading != blank %}<p class="rdc-fa__chips-heading">{{ s.chips_heading }}</p>{% endif %}
        <div class="rdc-fa__chips">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <span class="rdc-fa__chip" {{ block.shopify_attributes }}>
                {%- case block.settings.icon -%}
                  {%- when 'key' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.7 12.3 20 3"/><path d="M16 7l3 3"/><path d="M19 4l2 2"/></svg>
                  {%- when 'target' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/></svg>
                  {%- when 'sun' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
                  {%- when 'group' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3.6 19.5a5.5 5.5 0 0 1 10.8 0"/><path d="M16 5.4a3 3 0 0 1 0 5.2"/><path d="M17.4 13.6a5.5 5.5 0 0 1 3 4.4"/></svg>
                  {%- when 'calendar' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17"/><path d="M8 3v3M16 3v3"/><circle cx="12" cy="14.5" r="1.4" fill="currentColor"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9.5 11l2.5 2 2.5-2"/></svg>
                  {%- when 'trophy' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8v4a4 4 0 0 1-8 0V4z"/><path d="M8 5.5H5.6A2.4 2.4 0 0 0 8 9"/><path d="M16 5.5h2.4A2.4 2.4 0 0 1 16 9"/><path d="M12 12v3.5"/><path d="M9 19.5h6"/><path d="M9.8 19.5c0-1.4 1-2 2.2-2s2.2.6 2.2 2"/></svg>
                  {%- when 'book' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4a2 2 0 0 1 2-2h12v16H7a2 2 0 0 0-2 2z"/><path d="M5 20a2 2 0 0 1 2-2h12"/></svg>
                  {%- when 'gem' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/><path d="M9 3l3 6 3-6"/></svg>
                  {%- when 'compass' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>
                  {%- when 'flame' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c2 3 5 4.5 5 9a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.2 1 2 2 2.2C10.5 8 11 5.5 12 3z"/></svg>
                  {%- when 'map' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-6-7-12a7 7 0 0 1 14 0c0 6-7 12-7 12z"/><circle cx="12" cy="10" r="2.6"/></svg>
                  {%- when 'chat' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-3.9-.9L3 21l1.4-4.6A8.5 8.5 0 1 1 21 11.5z"/><path d="M8.5 11h7M8.5 14h4"/></svg>
                {%- endcase -%}
                {{ block.settings.label }}
              </span>
            {%- endfor -%}
          {%- else -%}
            <span class="rdc-fa__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.7 12.3 20 3"/><path d="M16 7l3 3"/><path d="M19 4l2 2"/></svg>Énigmes</span>
            <span class="rdc-fa__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/></svg>Missions</span>
            <span class="rdc-fa__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>Défis du jour</span>
            <span class="rdc-fa__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9.5 11l2.5 2 2.5-2"/></svg>Factions</span>
            <span class="rdc-fa__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8v4a4 4 0 0 1-8 0V4z"/><path d="M8 5.5H5.6A2.4 2.4 0 0 0 8 9"/><path d="M16 5.5h2.4A2.4 2.4 0 0 1 16 9"/><path d="M12 12v3.5"/><path d="M9 19.5h6"/><path d="M9.8 19.5c0-1.4 1-2 2.2-2s2.2.6 2.2 2"/></svg>Coupe des Héritages</span>
            <span class="rdc-fa__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-3.9-.9L3 21l1.4-4.6A8.5 8.5 0 1 1 21 11.5z"/><path d="M8.5 11h7M8.5 14h4"/></svg>Chat</span>
          {%- endif -%}
        </div>

        <div class="rdc-fa__actions">
          {% if s.free_text != blank %}<span class="rdc-fa__free"><span class="dot"></span>{{ s.free_text }}</span>{% endif %}
          {% if s.cta_url != blank %}<a class="rdc-fa__cta" href="{{ s.cta_url }}">{{ s.cta_label }} <span class="arrow" aria-hidden="true">&rarr;</span></a>{% endif %}
        </div>
        {% if s.note != blank %}<p class="rdc-fa__note">{{ s.note }}</p>{% endif %}
      </div>

      <div class="rdc-fa__stage">
        <div class="rdc-fa__phonewrap">
        <div class="rdc-fa__phone">
          <div class="rdc-fa__screen">
            {%- if s.app_video != blank -%}
              <video autoplay muted loop playsinline preload="auto"{% if poster_url != blank %} poster="{{ poster_url }}"{% endif %}>
                {%- for source in s.app_video.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}
              </video>
            {%- elsif s.video_external_url != blank -%}
              <video src="{{ s.video_external_url }}" autoplay muted loop playsinline preload="auto"{% if poster_url != blank %} poster="{{ poster_url }}"{% endif %}></video>
            {%- elsif poster_url != blank -%}
              <img src="{{ poster_url }}" alt="{{ s.title | escape }}" width="300" height="610" loading="lazy">
            {%- else -%}
              <div class="rdc-fa__screen-ph">Ajoute la vidéo de l'app (réglage « Vidéo »).</div>
            {%- endif -%}
          </div>
        </div>

        <div class="rdc-fa__reward{% unless s.card_dark %} rdc-fa__reward--light{% endunless %}">
          {% if s.reward_label != blank %}<span class="rdc-fa__reward-label">{{ s.reward_label }}</span>{% endif %}
          <div class="rdc-fa__illu">
            {% if illu != blank %}{{ illu | image_url: width: 600 | image_tag: loading: 'lazy', alt: s.title }}{% endif %}
          </div>
          <div class="rdc-fa__plaque">
            <span class="rdc-fa__seal">🏷️</span>
            <div><small>{{ s.plaque_label }}</small>
            <b id="rdc-fa-plaque-{{ section.id }}">{% if perso != blank %}{{ perso }}{% else %}{{ s.plaque_fallback }}{% endif %}</b></div>
          </div>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var SUPABASE_URL = {{ section.settings.supabase_url | json }};
    var SUPABASE_KEY = {{ section.settings.supabase_anon_key | json }};
    var HANDLE = {{ product.handle | json }};
    var SID = {{ section.id | json }};
    if (!SUPABASE_URL || !SUPABASE_KEY) return; // le fallback (texte + chiffres arrondis) reste affiché
    var HEADERS = { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY };

    // Stats de l'app (joueurs / lieux) — RPC get_app_stats, arrondi à la centaine inférieure
    fetch(SUPABASE_URL + '/rest/v1/rpc/get_app_stats', { method: 'POST', headers: HEADERS, body: '{}' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var row = Array.isArray(data) ? data[0] : data;
        if (!row) return;
        function fmt(n) { n = Math.floor((Number(n) || 0) / 100) * 100; return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' '); }
        var wrap = document.getElementById('rdc-fa-' + SID);
        if (!wrap) return;
        wrap.querySelectorAll('.rdc-fa-stat').forEach(function (el) {
          var k = el.getAttribute('data-stat');
          if (k === 'joueurs' && row.joueurs != null) el.textContent = fmt(row.joueurs);
          if (k === 'lieux' && row.lieux != null) el.textContent = fmt(row.lieux);
        });
      })
      .catch(function () {}); // fallback arrondi reste

    // Déblocages du Fragment (Titre) — RPC get_fragment_unlocks_by_product
    if (!HANDLE) return;
    fetch(SUPABASE_URL + '/rest/v1/rpc/get_fragment_unlocks_by_product', {
      method: 'POST', headers: HEADERS, body: JSON.stringify({ p_handle: HANDLE })
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var row = Array.isArray(data) ? data[0] : data;
        if (!row || !row.titre) return;
        var desc = document.getElementById('rdc-fa-titre-' + SID);
        if (desc) desc.textContent = 'le titre « ' + row.titre + ' », que tu portes en jeu';
        var plaque = document.getElementById('rdc-fa-plaque-' + SID);
        if (plaque) plaque.textContent = row.titre;
      })
      .catch(function (e) { console.error('RDC fragment-app:', e); }); // le fallback reste affiché
  })();
</script>

