<div class="rdc-fa-{{ section.id }}" id="rdc-fa-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="rdc-fa__card">
    <div class="rdc-fa__layout">
      <div class="rdc-fa__col">
        {% if s.pretitle != blank %}<p class="rdc-fa__pretitle">{{ s.pretitle }}</p>{% endif %}
        <h2 class="rdc-fa__title">{{ s.title }}</h2>
        {% if s.bridge != blank %}<p class="rdc-fa__bridge">{{ bridge_html }}</p>{% endif %}

        {% if s.unlocks_label != blank %}<p class="rdc-fa__lbl">{{ s.unlocks_label }}</p>{% endif %}
        <div class="rdc-fa__u">
          <div class="rdc-fa__med">{% render 'rdc_icon', name: s.unlock1_icon %}</div>
          <div><span class="rdc-fa__ut">{{ s.unlock1_title }}</span>
          <span class="rdc-fa__ud" id="rdc-fa-titre-{{ section.id }}">{{ unlock1_text }}</span></div>
        </div>
        <div class="rdc-fa__u">
          <div class="rdc-fa__med">{% render 'rdc_icon', name: s.unlock2_icon %}</div>
          <div><span class="rdc-fa__ut">{{ s.unlock2_title }}</span>
          <span class="rdc-fa__ud">{{ unlock2_text }}</span></div>
        </div>
        <div class="rdc-fa__u">
          <div class="rdc-fa__med">{% render 'rdc_icon', name: s.unlock3_icon %}</div>
          <div><span class="rdc-fa__ut">{{ s.unlock3_title }}</span>
          <span class="rdc-fa__ud">{{ s.unlock3_desc }}</span></div>
        </div>

        <div class="rdc-fa__actions">
          {% if s.free_text != blank %}<span class="rdc-fa__free"><span class="dot"></span>{{ s.free_text }}</span>{% endif %}
          {% if s.account_text != blank %}<span class="rdc-fa__free rdc-fa__free--violet"><span class="dot"></span>{{ s.account_text }}</span>{% endif %}
        </div>
      </div>

      <div class="rdc-fa__stage">
        <div class="rdc-fa__phonewrap">
        <div class="rdc-fa__phone">
          <div class="rdc-fa__screen">
            {%- if s.app_video != blank -%}
              <video autoplay muted loop playsinline preload="auto"{% if poster_url != blank %} poster="{{ poster_url }}"{% endif %}>
                {%- for source in s.app_video.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}
              </video>
            {%- elsif s.video_external_url != blank -%}
              <video src="{{ s.video_external_url }}" autoplay muted loop playsinline preload="auto"{% if poster_url != blank %} poster="{{ poster_url }}"{% endif %}></video>
            {%- elsif poster_url != blank -%}
              <img src="{{ poster_url }}" alt="{{ s.title | escape }}" width="300" height="610" loading="lazy">
            {%- else -%}
              <div class="rdc-fa__screen-ph">Ajoute la vidéo de l'app (réglage « Vidéo »).</div>
            {%- endif -%}
          </div>
        </div>

        <div class="rdc-fa__reward{% unless s.card_dark %} rdc-fa__reward--light{% endunless %}">
          {% if s.reward_label != blank %}<span class="rdc-fa__reward-label">{{ s.reward_label }}</span>{% endif %}
          <div class="rdc-fa__illu">
            {% if illu != blank %}{{ illu | image_url: width: 600 | image_tag: loading: 'lazy', alt: s.title }}{% endif %}
          </div>
          <div class="rdc-fa__plaque">
            <div><small>{{ s.plaque_label }}</small>
            <b id="rdc-fa-plaque-{{ section.id }}">{% if perso != blank %}{{ perso }}{% else %}{{ s.plaque_fallback }}{% endif %}</b></div>
          </div>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var SUPABASE_URL = {{ supa_url | json }};
    var SUPABASE_KEY = {{ supa_key | json }};
    var FRAG_TAG = {{ frag_tag | json }};
    var SID = {{ section.id | json }};
    if (!SUPABASE_URL || !SUPABASE_KEY) return; // le fallback (texte + chiffres arrondis) reste affiché
    var HEADERS = { 'Content-Type': 'application/json', 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY };

    // Stats de l'app (joueurs / lieux) — RPC existante get_landing_stats(), arrondi à la centaine inférieure
    fetch(SUPABASE_URL + '/rest/v1/rpc/get_landing_stats', { method: 'POST', headers: HEADERS, body: '{}' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var row = Array.isArray(data) ? data[0] : data;
        if (!row) return;
        function fmt(n) { n = Math.floor((Number(n) || 0) / 100) * 100; return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' '); }
        var wrap = document.getElementById('rdc-fa-' + SID);
        if (!wrap) return;
        wrap.querySelectorAll('.rdc-fa-stat').forEach(function (el) {
          var k = el.getAttribute('data-stat');
          if (k === 'joueurs' && row.total_users != null) el.textContent = fmt(row.total_users);
          if (k === 'lieux' && row.total_places != null) el.textContent = fmt(row.total_places);
        });
      })
      .catch(function () {}); // fallback arrondi reste

    // Déblocages du Fragment (Titre) — RPC get_fragment_unlocks_by_tag (tag produit fragment:xxx -> Hub)
    if (!FRAG_TAG) return;
    fetch(SUPABASE_URL + '/rest/v1/rpc/get_fragment_unlocks_by_tag', {
      method: 'POST', headers: HEADERS, body: JSON.stringify({ p_tag: FRAG_TAG })
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var row = Array.isArray(data) ? data[0] : data;
        if (!row || !row.titre) return;
        var desc = document.getElementById('rdc-fa-titre-' + SID);
        if (desc) desc.textContent = 'Le titre « ' + row.titre + ' », affichable sur la Carte';
        var plaque = document.getElementById('rdc-fa-plaque-' + SID);
        if (plaque) plaque.textContent = row.titre;
      })
      .catch(function (e) { console.error('RDC fragment-app:', e); }); // le fallback reste affiché
  })();
</script>
{%- endif -%}

