    { "type": "range", "id": "ghost_offset", "label": "Décalage vers la droite (desktop)", "unit": "%", "min": -80, "max": 30, "step": 2, "default": -24, "info": "Ce qui reste visible = largeur max moins ce décalage. Avec 70 % de largeur et -24 %, il en reste 46 %. Un décalage égal à la largeur max le fait disparaître entièrement." },
    { "type": "header", "content": "Décor du Fragment (image de fond)" },
