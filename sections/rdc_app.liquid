{%- comment -%}
  rdc_app.liquid — Section « L'application » (beat 6 de la home Boutique).

  2 colonnes : texte + téléphone avec vidéo de l'app. Sur mobile, ordre réorganisé
  (surtitre+titre → VIDÉO → reste) pour montrer vite que c'est une app.
  Features = blocs "feature" (label + icône au choix). Tokens du thème.
{%- endcomment -%}

{%- liquid
  assign uid = 'RdcApp-' | append: section.id
  assign s = section.settings
  assign poster_url = ''
  if s.video_poster != blank
    assign poster_url = s.video_poster | image_url: width: 720
  elsif s.app_video != blank and s.app_video.preview_image != blank
    assign poster_url = s.app_video.preview_image | image_url: width: 720
  endif
-%}

<style>
  #{{ uid }} { --rdc-app-accent: {{ s.accent_color }}; padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px; }
  #{{ uid }} .rdc-app__inner { max-width: 1180px; margin: 0 auto; padding-inline: 32px;
    display: grid; grid-template-columns: 1.05fr .95fr;
    grid-template-areas: "head stage" "body stage"; column-gap: 56px; align-content: center; }
  #{{ uid }} .rdc-app__head { grid-area: head; }
  #{{ uid }} .rdc-app__body { grid-area: body; }
  #{{ uid }} .rdc-app__stage { grid-area: stage; align-self: center; position: relative; display: flex; justify-content: center; }

  #{{ uid }} .rdc-app__over { font-family: var(--font-body--family); font-weight: 700; font-size: .8rem;
    letter-spacing: .3em; text-transform: uppercase; color: var(--rdc-app-accent); margin-bottom: 14px; }
  #{{ uid }} .rdc-app__title { font-family: var(--font-heading--family); font-weight: 400;
    font-size: clamp(2.6rem, 4.4vw, 4rem); line-height: .93; letter-spacing: .02em;
    color: var(--color-foreground-heading, var(--color-foreground)); margin: 0 0 18px; }
  #{{ uid }} .rdc-app__bridge { font-family: var(--font-fragment--family); font-style: italic;
    font-size: 1.3rem; color: var(--rdc-app-accent); max-width: 32ch; margin: 0 0 16px; line-height: 1.4; }
  #{{ uid }} .rdc-app__lead { font-family: var(--font-body--family); font-size: 1.04rem;
    color: var(--color-foreground); opacity: .85; line-height: 1.55; margin-bottom: 22px; max-width: 46ch; }

  #{{ uid }} .rdc-app__play { font-family: var(--font-heading--family); font-size: 1.4rem;
    color: var(--color-foreground); letter-spacing: .03em; margin-bottom: 13px; }
  #{{ uid }} .rdc-app__chips { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 24px; max-width: 34rem; }
  #{{ uid }} .rdc-app__chip { display: inline-flex; align-items: center; gap: 8px;
    background: rgb(var(--color-foreground-rgb) / .05); border: 1px solid rgb(var(--color-foreground-rgb) / .18);
    border-radius: 999px; padding: 8px 13px; font-family: var(--font-accent--family); font-weight: 700;
    font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-foreground); transition: .18s; }
  #{{ uid }} .rdc-app__chip svg { width: 16px; height: 16px; flex: 0 0 auto; color: var(--rdc-app-accent); }
  #{{ uid }} .rdc-app__chip:hover { border-color: var(--rdc-app-accent); color: var(--rdc-app-accent); }

  #{{ uid }} .rdc-app__free { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-accent--family);
    font-weight: 700; font-size: .76rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-foreground);
    background: var(--color-background); border: 1px solid rgb(var(--color-foreground-rgb) / .15);
    padding: 9px 16px; border-radius: 30px; margin-bottom: 22px; }
  #{{ uid }} .rdc-app__free .dot { width: 8px; height: 8px; border-radius: 50%; background: #39b35a; box-shadow: 0 0 0 4px rgba(57,179,90,.18); }
  #{{ uid }} .rdc-app__cta { display: inline-flex; align-items: center; gap: 9px; background: var(--rdc-app-accent); color: #fff;
    font-family: var(--font-accent--family); font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    font-size: .92rem; padding: 15px 28px; border-radius: var(--style-border-radius-buttons, 8px); text-decoration: none; transition: .2s; }
  #{{ uid }} .rdc-app__cta:hover { filter: brightness(.9); }

  #{{ uid }} .rdc-app__glow { position: absolute; width: 78%; height: 78%; z-index: 0;
    background: radial-gradient(circle, rgb(var(--color-foreground-rgb) / .0) 65%, transparent 66%); }
  #{{ uid }} .rdc-app__phone { position: relative; z-index: 1; width: 300px; max-width: 78vw; aspect-ratio: 300 / 610;
    background: #1a1410; border-radius: 44px; padding: 11px; box-shadow: 0 40px 80px -28px rgba(40,30,15,.5), 0 0 0 2px rgba(0,0,0,.25) inset; }
  #{{ uid }} .rdc-app__screen { position: relative; width: 100%; height: 100%; border-radius: 34px; overflow: hidden; background: #1a1410; }
  #{{ uid }} .rdc-app__screen video, #{{ uid }} .rdc-app__screen img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #{{ uid }} .rdc-app__ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center;
    color: #e9dcc4; font-family: var(--font-body--family); font-size: .82rem; padding: 22px;
    background: linear-gradient(135deg, #55584a, #2b2d23); }

  @media (max-width: 820px) {
    #{{ uid }} { padding-block: {{ s.padding_top | times: 0.7 | round }}px {{ s.padding_bottom | times: 0.7 | round }}px; }
    #{{ uid }} .rdc-app__inner { grid-template-columns: 1fr; grid-template-areas: "head" "stage" "body"; column-gap: 0; text-align: center; }
    #{{ uid }} .rdc-app__stage { margin: 22px 0 26px; }
    #{{ uid }} .rdc-app__bridge { margin-inline: auto; }
    #{{ uid }} .rdc-app__lead, #{{ uid }} .rdc-app__chips { max-width: none; }
    #{{ uid }} .rdc-app__chips { justify-content: center; }
    #{{ uid }} .rdc-app__phone { width: 248px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #{{ uid }} .rdc-app__screen video { animation: none; }
  }
</style>

{%- if s.anchor_id != blank -%}<span id="{{ s.anchor_id }}" aria-hidden="true" style="display:block;scroll-margin-top:var(--header-group-height,90px)"></span>{%- endif -%}
<div class="section-background color-{{ s.color_scheme }}"></div>
<div id="{{ uid }}" class="section section--full-width color-{{ s.color_scheme }} rdc-app">
  <div class="rdc-app__inner">

    <div class="rdc-app__head">
      {%- if s.overline != blank -%}<div class="rdc-app__over">{{ s.overline }}</div>{%- endif -%}
      {%- if s.title != blank -%}<h2 class="rdc-app__title">{{ s.title }}</h2>{%- endif -%}
    </div>

    <div class="rdc-app__stage">
      <div class="rdc-app__glow"></div>
      <div class="rdc-app__phone"><div class="rdc-app__screen">
        {%- if s.app_video != blank -%}
          <video autoplay muted loop playsinline preload="auto"{% if poster_url != blank %} poster="{{ poster_url }}"{% endif %}>
            {%- for source in s.app_video.sources -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
        {%- elsif s.video_external_url != blank -%}
          <video src="{{ s.video_external_url }}" autoplay muted loop playsinline preload="auto"{% if poster_url != blank %} poster="{{ poster_url }}"{% endif %}></video>
        {%- elsif poster_url != blank -%}
          <img src="{{ poster_url }}" alt="{{ s.title | escape }}" loading="lazy">
        {%- else -%}
          <div class="rdc-app__ph">Ajoute une vidéo de l'app (réglage « Vidéo ») ou une image.</div>
        {%- endif -%}
      </div></div>
    </div>

    <div class="rdc-app__body">
      {%- if s.bridge != blank -%}<p class="rdc-app__bridge">{{ s.bridge }}</p>{%- endif -%}
      {%- if s.lead != blank -%}<p class="rdc-app__lead">{{ s.lead }}</p>{%- endif -%}

      {%- if s.play_heading != blank -%}<div class="rdc-app__play">{{ s.play_heading }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="rdc-app__chips">
          {%- for block in section.blocks -%}
            <span class="rdc-app__chip" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'key' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.7 12.3 20 3"/><path d="M16 7l3 3"/><path d="M19 4l2 2"/></svg>
                {%- when 'target' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/></svg>
                {%- when 'sun' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>
                {%- when 'group' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3.6 19.5a5.5 5.5 0 0 1 10.8 0"/><path d="M16 5.4a3 3 0 0 1 0 5.2"/><path d="M17.4 13.6a5.5 5.5 0 0 1 3 4.4"/></svg>
                {%- when 'calendar' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17"/><path d="M8 3v3M16 3v3"/><circle cx="12" cy="14.5" r="1.4" fill="currentColor"/></svg>
                {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9.5 11l2.5 2 2.5-2"/></svg>
                {%- when 'trophy' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8v4a4 4 0 0 1-8 0V4z"/><path d="M8 5.5H5.6A2.4 2.4 0 0 0 8 9"/><path d="M16 5.5h2.4A2.4 2.4 0 0 1 16 9"/><path d="M12 12v3.5"/><path d="M9 19.5h6"/><path d="M9.8 19.5c0-1.4 1-2 2.2-2s2.2.6 2.2 2"/></svg>
                {%- when 'book' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4a2 2 0 0 1 2-2h12v16H7a2 2 0 0 0-2 2z"/><path d="M5 20a2 2 0 0 1 2-2h12"/></svg>
                {%- when 'gem' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/><path d="M9 3l3 6 3-6"/></svg>
                {%- when 'compass' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>
                {%- when 'flame' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c2 3 5 4.5 5 9a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.2 1 2 2 2.2C10.5 8 11 5.5 12 3z"/></svg>
                {%- when 'map' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-6-7-12a7 7 0 0 1 14 0c0 6-7 12-7 12z"/><circle cx="12" cy="10" r="2.6"/></svg>
                {%- when 'chat' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-3.9-.9L3 21l1.4-4.6A8.5 8.5 0 1 1 21 11.5z"/><path d="M8.5 11h7M8.5 14h4"/></svg>
              {%- endcase -%}
              {{ block.settings.label }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.free_text != blank -%}<div class="rdc-app__free"><span class="dot"></span>{{ s.free_text }}</div>{%- endif -%}
      {%- if s.cta_label != blank and s.cta_url != blank -%}
        <div><a class="rdc-app__cta" href="{{ s.cta_url }}">{{ s.cta_label }} →</a></div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "RDC — L'application",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "L'application" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ton territoire, un terrain d'aventure." },
    { "type": "textarea", "id": "bridge", "label": "Phrase-pont", "default": "« Une marque. Une application. L'une vous fait porter l'Histoire. La seconde vous la fait vivre. »" },
    { "type": "textarea", "id": "lead", "label": "Paragraphe", "default": "La plus grosse communauté francophone jamais fédérée autour de l'Histoire, l'Aventure & la Nature — dans ta poche." },
    { "type": "text", "id": "play_heading", "label": "Accroche features", "default": "Une carte. Mille façons de jouer." },
    { "type": "text", "id": "free_text", "label": "Badge", "default": "Gratuit · un clic · rien à installer" },

    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "cta_label", "label": "Libellé du bouton", "default": "Essayer l'application" },
    { "type": "text", "id": "cta_url", "label": "Lien du bouton", "info": "URL complète", "default": "https://app.runesdechene.com" },

    { "type": "header", "content": "Vidéo de l'app" },
    { "type": "video", "id": "app_video", "label": "Vidéo (recommandé — Shopify l'optimise)" },
    { "type": "text", "id": "video_external_url", "label": "OU URL vidéo externe (mp4/webm)", "info": "Utilisé si aucune vidéo ci-dessus", "default": "https://cdn.shopify.com/videos/c/o/v/f6c638bf0b134d7397ba964e6acf4417.mp4" },
    { "type": "image_picker", "id": "video_poster", "label": "Image de repli (poster)" },

    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleur", "default": "scheme-1" },
    { "type": "color", "id": "accent_color", "label": "Couleur d'accent", "default": "#962B21" },
    { "type": "range", "id": "padding_top", "label": "Marge haut (px)", "min": 0, "max": 160, "step": 4, "default": 84 },
    { "type": "range", "id": "padding_bottom", "label": "Marge bas (px)", "min": 0, "max": 160, "step": 4, "default": 84 },

    { "type": "header", "content": "Ancre" },
    { "type": "text", "id": "anchor_id", "label": "Ancre (ID)", "info": "Ex. « application » → lie un bouton avec #application. Sans espace ni accent.", "default": "application" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Atout (chip)",
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Énigmes" },
        { "type": "select", "id": "icon", "label": "Icône", "default": "key", "options": [
          { "value": "key", "label": "Clé (énigmes)" },
          { "value": "target", "label": "Cible (missions)" },
          { "value": "sun", "label": "Soleil (défis du jour)" },
          { "value": "group", "label": "Groupe (collectifs)" },
          { "value": "calendar", "label": "Calendrier (événements)" },
          { "value": "shield", "label": "Blason (factions)" },
          { "value": "trophy", "label": "Trophée (coupe)" },
          { "value": "book", "label": "Carnet" },
          { "value": "gem", "label": "Fragment (gemme)" },
          { "value": "compass", "label": "Boussole" },
          { "value": "flame", "label": "Flamme" },
          { "value": "map", "label": "Lieu (pin)" },
          { "value": "chat", "label": "Chat (bulle)" }
        ] }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "RDC — L'application",
      "blocks": [
        { "type": "feature", "settings": { "label": "Énigmes", "icon": "key" } },
        { "type": "feature", "settings": { "label": "Missions", "icon": "target" } },
        { "type": "feature", "settings": { "label": "Défis du jour", "icon": "sun" } },
        { "type": "feature", "settings": { "label": "Défis collectifs", "icon": "group" } },
        { "type": "feature", "settings": { "label": "Événements", "icon": "calendar" } },
        { "type": "feature", "settings": { "label": "Factions", "icon": "shield" } },
        { "type": "feature", "settings": { "label": "Coupe des Héritages", "icon": "trophy" } },
        { "type": "feature", "settings": { "label": "Chat communautaire", "icon": "chat" } }
      ]
    }
  ]
}
{% endschema %}
