{% comment %}
  RDC — Ils nous portent PAR PRODUIT (fiche produit).
  Grille pleine largeur de vignettes nues (sans texte par-dessus). Clic -> modale : grande image
  + overlay en bas (nom + notes en émojis ⭐ + avis). Données : RPC anon get_community_photos_by_product.
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">

<style>
  .rdc-inp-{{ section.id }} { max-width: var(--page-content-width, 120rem); margin-inline: auto; padding: 1.5rem 0 3rem; }
  .rdc-inp-{{ section.id }} .rdc-inp__header { text-align: left; margin-bottom: 1rem; }
  .rdc-inp-{{ section.id }} .rdc-inp__title {
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: .95;
    letter-spacing: .01em;
    text-align: left;
    margin: 0;
    color: var(--color-foreground, #2b2b2b);
  }
  .rdc-inp-{{ section.id }} .rdc-inp__subtitle {
    text-align: left;
    margin: .15rem 0 0;
    font-size: 1rem;
    color: #6b4c3b;
  }

  /* Grille pleine largeur, vignettes nues et petites */
  .rdc-inp-{{ section.id }} .rdc-inp__grid {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 4px;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    padding-bottom: 6px;
  }
  .rdc-inp-{{ section.id }} .rdc-inp__photo {
    height: 220px;
    width: auto;
    max-width: none;
    flex: 0 0 auto;
    display: block;
    cursor: pointer;
    background: #ece5d8;
    scroll-snap-align: start;
    transition: filter .2s ease;
  }
  .rdc-inp-{{ section.id }} .rdc-inp__photo:hover { filter: brightness(1.06); }

  .rdc-inp-{{ section.id }} .rdc-inp__loading,
  .rdc-inp-{{ section.id }} .rdc-inp__empty {
    color: #8b6f5e; font-size: .95rem; padding: 1.5rem 0;
  }

  @media (max-width: 749px) {
    .rdc-inp-{{ section.id }} .rdc-inp__grid { gap: 3px; }
    .rdc-inp-{{ section.id }} .rdc-inp__photo { height: 160px; }
    .rdc-inp-{{ section.id }} .rdc-inp__title { font-size: clamp(2rem, 9vw, 2.8rem); }
  }

  /* Modale : grande image + overlay infos en bas */
  .rdc-inp-modal-{{ section.id }} {
    display: none;
    position: fixed; inset: 0; z-index: 99999;
    background: rgba(0,0,0,.86);
    align-items: center; justify-content: center;
    padding: 4vh 4vw;
  }
  .rdc-inp-modal-{{ section.id }}.is-open { display: flex; }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__modal-inner {
    position: relative;
    max-width: min(92vw, 760px);
    max-height: 92vh;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__modal-img {
    display: block;
    max-width: 100%;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 8px;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__modal-overlay {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 48px 22px 20px;
    background: linear-gradient(to top, rgba(0,0,0,.82) 0%, rgba(0,0,0,.35) 55%, transparent 100%);
    color: #fff;
    border-radius: 0 0 8px 8px;
    pointer-events: none;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__modal-name {
    font-family: var(--font-heading--family, serif);
    font-size: 1.5rem; line-height: 1.2; margin-bottom: 6px;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__verified {
    display: inline-flex; align-items: center; gap: 3px;
    font-family: var(--font-body--family, sans-serif);
    font-size: .68rem; font-weight: 600; letter-spacing: .02em;
    color: #d7f0d0; background: rgba(34, 197, 94, .22);
    border: 1px solid rgba(34, 197, 94, .55);
    padding: 2px 8px; border-radius: 999px;
    vertical-align: middle; white-space: nowrap;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__modal-rating {
    font-size: .95rem; letter-spacing: .04em; margin-top: 2px;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__star-off { filter: grayscale(1); opacity: .4; }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__modal-msg {
    font-size: .98rem; font-style: italic; margin-top: 8px; opacity: .92; line-height: 1.4;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__close {
    position: absolute; top: -38px; right: 0;
    background: none; border: none; color: #fff;
    font-size: 1.9rem; line-height: 1; cursor: pointer; opacity: .85;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__close:hover { opacity: 1; }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__nav {
    position: fixed; top: 50%; transform: translateY(-50%);
    width: 46px; height: 46px; border-radius: 50%;
    border: none; background: rgba(255,255,255,.16); color: #fff;
    font-size: 1.9rem; line-height: 1; cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 6; transition: background .2s;
  }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__nav:hover { background: rgba(255,255,255,.32); }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__nav--prev { left: max(2vw, 12px); }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__nav--next { right: max(2vw, 12px); }
  .rdc-inp-modal-{{ section.id }} .rdc-inp__counter {
    position: absolute; bottom: 12px; right: 12px;
    background: rgba(0,0,0,.6); color: #fff;
    font-size: .78rem; letter-spacing: .03em;
    padding: 3px 10px; border-radius: 999px; z-index: 4;
  }
  @media (max-width: 749px) {
    .rdc-inp-modal-{{ section.id }} .rdc-inp__nav { width: 38px; height: 38px; font-size: 1.5rem; }
  }
</style>

<div class="rdc-inp-{{ section.id }}" id="rdc-inp-{{ section.id }}">
  <div class="rdc-inp__header">
    {% if section.settings.title != blank %}<h2 class="rdc-inp__title">{{ section.settings.title }}</h2>{% endif %}
    {% if section.settings.subtitle != blank %}<p class="rdc-inp__subtitle">{{ section.settings.subtitle }}</p>{% endif %}
  </div>
  <div class="rdc-inp__loading" id="rdc-inp-loading-{{ section.id }}">Chargement…</div>
  <div class="rdc-inp__grid" id="rdc-inp-grid-{{ section.id }}" style="display: none;"></div>
  <div class="rdc-inp__empty" id="rdc-inp-empty-{{ section.id }}" style="display: none;">Aucune photo pour le moment.</div>
</div>

<div class="rdc-inp-modal-{{ section.id }}" id="rdc-inp-modal-{{ section.id }}">
  <button class="rdc-inp__nav rdc-inp__nav--prev" id="rdc-inp-prev-{{ section.id }}" aria-label="Précédent">&#x2039;</button>
  <button class="rdc-inp__nav rdc-inp__nav--next" id="rdc-inp-next-{{ section.id }}" aria-label="Suivant">&#x203A;</button>
  <div class="rdc-inp__modal-inner">
    <button class="rdc-inp__close" aria-label="Fermer">&#x2715;</button>
    <img class="rdc-inp__modal-img" id="rdc-inp-modal-img-{{ section.id }}" src="" alt="" />
    <div class="rdc-inp__modal-overlay" id="rdc-inp-modal-overlay-{{ section.id }}"></div>
    <span class="rdc-inp__counter" id="rdc-inp-counter-{{ section.id }}"></span>
  </div>
</div>

<script>
  (function () {
    var SUPABASE_URL = {{ section.settings.supabase_url | json }};
    var SUPABASE_KEY = {{ section.settings.supabase_anon_key | json }};
    var PRODUCT_HANDLE = {{ product.handle | json }};
    var SID = {{ section.id | json }};

    var gridEl = document.getElementById('rdc-inp-grid-' + SID);
    var loadingEl = document.getElementById('rdc-inp-loading-' + SID);
    var emptyEl = document.getElementById('rdc-inp-empty-' + SID);
    var modalEl = document.getElementById('rdc-inp-modal-' + SID);
    var modalImg = document.getElementById('rdc-inp-modal-img-' + SID);
    var overlayEl = document.getElementById('rdc-inp-modal-overlay-' + SID);
    var closeBtn = modalEl.querySelector('.rdc-inp__close');
    var navPrev = document.getElementById('rdc-inp-prev-' + SID);
    var navNext = document.getElementById('rdc-inp-next-' + SID);
    var counterEl = document.getElementById('rdc-inp-counter-' + SID);
    var allRows = [];
    var current = 0;

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function stars(n) {
      n = Math.max(0, Math.min(5, parseInt(n, 10) || 0));
      var html = '⭐'.repeat(n);
      for (var i = n; i < 5; i++) html += '<span class="rdc-inp__star-off">⭐</span>';
      return html;
    }

    function buildOverlay(row) {
      var html = '';
      if (row.submitter_name) html += '<div class="rdc-inp__modal-name">' + esc(row.submitter_name) + ' <span class="rdc-inp__verified">✓ Avis vérifié · produit acheté</span></div>';
      if (row.rating_experience) html += '<div class="rdc-inp__modal-rating">Expérience ' + stars(row.rating_experience) + '</div>';
      if (row.rating_products) html += '<div class="rdc-inp__modal-rating">Produits ' + stars(row.rating_products) + '</div>';
      if (row.message) html += '<div class="rdc-inp__modal-msg">« ' + esc(row.message) + ' »</div>';
      return html;
    }
    function renderModal() {
      var row = allRows[current];
      if (!row) return;
      modalImg.src = row.image_url;
      modalImg.alt = 'Photo de ' + (row.submitter_name || 'la communauté');
      overlayEl.innerHTML = buildOverlay(row);
      var multi = allRows.length > 1;
      counterEl.textContent = (current + 1) + ' / ' + allRows.length;
      counterEl.style.display = multi ? '' : 'none';
      navPrev.style.display = multi ? '' : 'none';
      navNext.style.display = multi ? '' : 'none';
    }
    function openModal(idx) {
      current = idx;
      renderModal();
      modalEl.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function go(dir) {
      if (!allRows.length) return;
      current = (current + dir + allRows.length) % allRows.length;
      renderModal();
    }
    navPrev.addEventListener('click', function (e) { e.stopPropagation(); go(-1); });
    navNext.addEventListener('click', function (e) { e.stopPropagation(); go(1); });
    function closeModal() {
      modalEl.classList.remove('is-open');
      modalImg.src = '';
      document.body.style.overflow = '';
    }
    closeBtn.addEventListener('click', closeModal);
    modalEl.addEventListener('click', function (e) { if (e.target === modalEl) closeModal(); });
    document.addEventListener('keydown', function (e) {
      if (!modalEl.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeModal();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
    var touchX = null;
    modalEl.addEventListener('touchstart', function (e) { touchX = e.changedTouches[0].clientX; }, { passive: true });
    modalEl.addEventListener('touchend', function (e) {
      if (touchX === null) return;
      var dx = e.changedTouches[0].clientX - touchX;
      touchX = null;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
    }, { passive: true });

    if (!SUPABASE_URL || !SUPABASE_KEY || !PRODUCT_HANDLE) {
      loadingEl.style.display = 'none';
      emptyEl.style.display = 'block';
      if (!PRODUCT_HANDLE) emptyEl.textContent = 'Configuration manquante (handle produit).';
      return;
    }

    fetch(SUPABASE_URL + '/rest/v1/rpc/get_community_photos_by_product', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'apikey': SUPABASE_KEY,
        'Authorization': 'Bearer ' + SUPABASE_KEY
      },
      body: JSON.stringify({ p_handle: PRODUCT_HANDLE })
    })
      .then(function (res) { return res.json(); })
      .then(function (rows) {
        loadingEl.style.display = 'none';
        allRows = (rows || []).filter(function (r) { return r.image_url; });
        if (!allRows.length) { emptyEl.style.display = 'block'; return; }
        gridEl.style.display = 'flex';
        allRows.forEach(function (row, i) {
          var img = document.createElement('img');
          img.className = 'rdc-inp__photo';
          img.src = row.image_url;
          img.loading = 'lazy';
          img.alt = 'Photo de ' + (row.submitter_name || 'la communauté');
          img.addEventListener('click', function () { openModal(i); });
          gridEl.appendChild(img);
        });
      })
      .catch(function (err) {
        console.error('RDC ils-nous-portent:', err);
        loadingEl.style.display = 'none';
        emptyEl.style.display = 'block';
      });
  })();
</script>

{% schema %}
{
  "name": "RDC Ils nous portent",
  "tag": "section",
  "class": "section-rdc-ils-nous-portent",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Ils portent ce modèle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "La communauté Runes de Chêne en parle"
    },
    {
      "type": "text",
      "id": "supabase_url",
      "label": "URL Supabase",
      "info": "Ex: https://xxxxx.supabase.co"
    },
    {
      "type": "text",
      "id": "supabase_anon_key",
      "label": "Clé Supabase (anon)"
    }
  ],
  "presets": [
    {
      "name": "RDC Ils nous portent"
    }
  ]
}
{% endschema %}
