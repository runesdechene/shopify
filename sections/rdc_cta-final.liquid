{%- comment -%}
  rdc_cta-final.liquid — CTA de clôture de la home.

  Bande FULL-WIDTH plate : photo de shooting plein cadre, voile léger, texte plat
  (sur-titre + titre Bebas + ligne Alegreya + bouton doré). Coupes "vague douce"
  en haut et en bas (clip-path) qui laissent réapparaître la page → effet immersif.
  Aligné sur l'esthétique flat du site (pas de carte, pas d'ombre, pas de flou).

  Spec : docs/superpowers/specs/2026-06-13-rdc-cta-final-diptyque-design.md
{%- endcomment -%}

{%- liquid
  assign uid = 'RdcCta-' | append: section.id
  assign s = section.settings
  assign img_url   = s.image | image_url: width: 2400
  assign img_url_m = s.image_mobile | image_url: width: 1200
  assign bright = s.photo_brightness | default: 80 | divided_by: 100.0
  assign scrim  = s.scrim_opacity | default: 40 | divided_by: 100.0

  # Inclinaison parallèle (parallélogramme) : cut_depth en % de la hauteur, sens réglable
  assign d = s.cut_depth
  assign b = 100 | minus: d
  # Bas droit : la bande descend jusqu'au pied de page, que la forêt immersive vient recouvrir
  if s.cut_bottom == false
    assign b = 100
  endif
  if s.cut_direction == 'left'
    assign clip = '0% 0%, 100% ' | append: d | append: '%, 100% 100%, 0% ' | append: b | append: '%'
  else
    assign clip = '0% ' | append: d | append: '%, 100% 0%, 100% ' | append: b | append: '%, 0% 100%'
  endif

  assign align_items = 'center'
  if s.content_align == 'left'
    assign align_items = 'flex-start'
  endif
-%}

<style>
  #{{ uid }} { padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px; }
  {%- if s.under_footer > 0 -%}
  {%- comment -%} La bande glisse sous le haut du pied de page : la forêt immersive la recouvre.
      Le fond uni de la forêt passe transparent, sinon il cacherait la bande. {%- endcomment -%}
  #{{ uid }} { margin-bottom: -{{ s.under_footer }}px; position: relative; z-index: 0; }
  .forest-wrapper { background-color: transparent !important; position: relative; z-index: 1; }
  {%- endif -%}

  #{{ uid }} .rdc-ctaf__band {
    position: relative; width: 100%; min-height: {{ s.min_height }}px; overflow: hidden;
    {% if s.image != blank %}--rdc-img: url('{{ img_url }}');{% endif %}
    clip-path: polygon({{ clip }});
    display: flex;
  }

  #{{ uid }} .rdc-ctaf__bg {
    position: absolute; inset: 0; z-index: 0;
    {% if s.image != blank %}background-image: var(--rdc-img);{% else %}background: linear-gradient(135deg, #55584a, #2b2118);{% endif %}
    background-size: cover; background-position: center 35%;
    filter: saturate(.82) brightness({{ bright }}) sepia(.06);
    transform: scale(1.05); transform-origin: center;
    {% if s.animate and s.image != blank %}animation: rdcCtaKb 18s ease-in-out infinite alternate;{% endif %}
  }
  #{{ uid }} .rdc-ctaf__scrim { position: absolute; inset: 0; z-index: 1;
    background: rgba(20,14,8,{{ scrim }}); }

  #{{ uid }} .rdc-ctaf__ct {
    position: relative; z-index: 2; width: 100%;
    display: flex; flex-direction: column; justify-content: center; align-items: {{ align_items }};
    gap: 16px; padding: clamp(48px, 7vw, 96px) clamp(24px, 8vw, 110px);
    text-align: {{ s.content_align }}; box-sizing: border-box;
  }
  #{{ uid }} .rdc-ctaf__over { font-family: var(--font-body--family); font-weight: 700; font-size: .8rem;
    letter-spacing: .3em; text-transform: uppercase; color: {{ s.accent_color }}; margin: 0; }
  #{{ uid }} .rdc-ctaf__title { font-family: var(--font-heading--family, sans-serif);
    font-size: clamp(2.6rem, 6.5vw, 6.2rem); line-height: .84; letter-spacing: .02em; margin: 0;
    color: {{ s.title_color }}; }
  #{{ uid }} .rdc-ctaf__sub { font-family: var(--font-body--family); font-style: normal;
    font-size: 1.06rem; line-height: 1.45; color: #efe7d6; margin: 0; max-width: 46ch; }
  #{{ uid }} .rdc-ctaf__sub p { margin: 0; }

  #{{ uid }} .rdc-ctaf__btn { margin-top: 6px; display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--font-body--family); font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    font-size: .92rem; padding: 15px 30px; border-radius: 999px; text-decoration: none;
    background: {{ s.button_bg }}; color: {{ s.button_text }}; border: 1px solid rgba(0,0,0,.5);
    transition: transform .2s ease, filter .2s ease; }
  #{{ uid }} .rdc-ctaf__btn:hover { transform: translateY(-2px); filter: brightness(.96); }

  {%- comment -%} L'inscription : un champ et un bouton sur une ligne, le lien vers les collections dessous. {%- endcomment -%}
  #{{ uid }} .rdc-ctaf__form { display: flex; gap: 10px; margin-top: 6px; width: min(100%, 620px); }
  #{{ uid }} .rdc-ctaf__input { flex: 1; min-width: 0; padding: 15px 22px; border-radius: 999px;
    border: 1px solid rgba(252,249,241,.55); background: rgba(252,249,241,.08); color: #fcf9f1;
    font-family: var(--font-body--family); font-size: .95rem; }
  #{{ uid }} .rdc-ctaf__input::placeholder { color: rgba(252,249,241,.6); }
  {%- comment -%} Après la règle commune, sinon son « flex: 1 » l'emporte : un prénom est plus court qu'un email. {%- endcomment -%}
  #{{ uid }} .rdc-ctaf__input--prenom { flex: 0 0 150px; }
  #{{ uid }} .rdc-ctaf__submit { padding: 15px 26px; border-radius: 999px; border: 0; cursor: pointer;
    background: #fcf9f1; color: #1f1a14; font-family: var(--font-body--family); font-weight: 700;
    font-size: .9rem; letter-spacing: .06em; text-transform: uppercase; transition: transform .2s ease; }
  #{{ uid }} .rdc-ctaf__submit:hover { transform: translateY(-2px); }
  #{{ uid }} .rdc-ctaf__msg { font-family: var(--font-body--family); font-size: 1rem; color: #fcf9f1; margin: 6px 0 0; }
  #{{ uid }} .rdc-ctaf__link { font-family: var(--font-body--family); font-size: .9rem; color: rgba(252,249,241,.8);
    text-decoration: underline; text-underline-offset: 3px; }
  #{{ uid }} .rdc-ctaf__link:hover { color: #fcf9f1; }
  @media (max-width: 749px) {
    #{{ uid }} .rdc-ctaf__form { flex-direction: column; }
    #{{ uid }} .rdc-ctaf__input--prenom { flex-basis: auto; }
  }
  {%- if s.show_email -%}
  {%- comment -%} Le bandeau recueille déjà l'email : on cache l'inscription du pied de page sur cette page. {%- endcomment -%}
  {%- comment -%} Le bloc qui encadre l'inscription (sa bordure resterait seule, en trait). {%- endcomment -%}
  .group-block:has(> .group-block-content > .rdc-nl), .rdc-nl { display: none; }
  {%- endif -%}

  @keyframes rdcCtaKb { from { transform: scale(1.05); } to { transform: scale(1.14); } }
  @media (prefers-reduced-motion: reduce) { #{{ uid }} .rdc-ctaf__bg { animation: none; } }

  @media (max-width: 749px) {
    #{{ uid }} .rdc-ctaf__band { min-height: {{ s.height_mobile }}px;
      {% if s.image_mobile != blank %}--rdc-img: url('{{ img_url_m }}');{% endif %} }
    #{{ uid }} .rdc-ctaf__ct { padding: clamp(56px, 16vw, 90px) 26px; }
    #{{ uid }} .rdc-ctaf__title { font-size: clamp(2.8rem, 13vw, 5rem); }
  }
</style>

{%- if s.anchor_id != blank -%}<span id="{{ s.anchor_id }}" aria-hidden="true" style="display:block;scroll-margin-top:var(--header-group-height,90px)"></span>{%- endif -%}
<div id="{{ uid }}" class="section section--full-width color-{{ s.color_scheme }} rdc-ctaf">
  <div class="rdc-ctaf__band">
    <div class="rdc-ctaf__bg" aria-hidden="true"></div>
    <div class="rdc-ctaf__scrim" aria-hidden="true"></div>
    <div class="rdc-ctaf__ct">
      {%- if s.overline != blank -%}<p class="rdc-ctaf__over">{{ s.overline }}</p>{%- endif -%}
      {%- if s.title != blank -%}<h2 class="rdc-ctaf__title">{{ s.title }}</h2>{%- endif -%}
      {%- if s.subtitle != blank -%}<div class="rdc-ctaf__sub">{{ s.subtitle }}</div>{%- endif -%}
      {%- if s.show_email -%}
        {%- comment -%} Formulaire client natif de Shopify : l'adresse rejoint les abonnés de la boutique,
            que le Hub synchronise. L'id ramène la page ici après l'envoi. {%- endcomment -%}
        {%- form 'customer', id: 'RdcCtaEmail', class: 'rdc-ctaf__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="rdc-ctaf__msg">{{ s.email_success }}</p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter,accueil-bandeau-final">
            <label for="RdcCtaFirstName" class="visually-hidden">Prénom</label>
            <input id="RdcCtaFirstName" class="rdc-ctaf__input rdc-ctaf__input--prenom" type="text" name="contact[first_name]"
              autocomplete="given-name" autocapitalize="words" placeholder="{{ s.firstname_placeholder }}">
            <label for="RdcCtaEmailInput" class="visually-hidden">E-mail</label>
            <input id="RdcCtaEmailInput" class="rdc-ctaf__input" type="email" name="contact[email]"
              autocomplete="email" autocapitalize="off" required placeholder="{{ s.email_placeholder }}">
            <button class="rdc-ctaf__submit" type="submit">{{ s.email_button }}</button>
          {%- endif -%}
        {%- endform -%}
        {%- if s.link_label != blank -%}<a class="rdc-ctaf__link" href="{{ s.link_url | default: '/collections' }}">{{ s.link_label }}</a>{%- endif -%}
      {%- elsif s.button_label != blank -%}
        <a class="rdc-ctaf__btn" href="{{ s.button_url | default: '#' }}">{{ s.button_label }} →</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "RDC — CTA final",
  "tag": "section",
  "class": "rdc-cta-final-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Contenu" },
    { "type": "inline_richtext", "id": "overline", "label": "Sur-titre", "default": "Le voyage continue" },
    { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Porte ton Fragment d'Histoire" },
    { "type": "richtext", "id": "subtitle", "label": "Ligne d'accent", "default": "<p>Des créations à porter, un monde à explorer.</p>" },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton", "default": "Explorer la boutique" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton", "info": "Choisis la Page Boutique ou une Collection." },
    { "type": "header", "content": "Inscription e-mail" },
    { "type": "checkbox", "id": "show_email", "label": "Remplacer le bouton par un champ e-mail", "default": false },
    { "type": "text", "id": "firstname_placeholder", "label": "Texte du champ prénom", "default": "Ton prénom" },
    { "type": "text", "id": "email_placeholder", "label": "Texte du champ e-mail", "default": "Ton adresse e-mail" },
    { "type": "text", "id": "email_button", "label": "Bouton", "default": "Me prévenir" },
    { "type": "text", "id": "email_success", "label": "Message après l'inscription", "default": "C'est noté. Tu seras prévenu avant tout le monde." },
    { "type": "text", "id": "link_label", "label": "Petit lien sous le champ", "default": "Voir les collections" },
    { "type": "url", "id": "link_url", "label": "Lien" },
    { "type": "select", "id": "content_align", "label": "Alignement", "options": [
      { "value": "center", "label": "Centré" }, { "value": "left", "label": "Gauche" } ], "default": "center" },

    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Image (bureau)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Si vide, l'image bureau est utilisée." },
    { "type": "range", "id": "photo_brightness", "label": "Luminosité de la photo", "unit": "%", "min": 30, "max": 100, "step": 5, "default": 80 },
    { "type": "range", "id": "scrim_opacity", "label": "Voile sur toute l'image", "unit": "%", "min": 0, "max": 90, "step": 5, "default": 40 },
    { "type": "checkbox", "id": "animate", "label": "Animation (zoom lent)", "info": "Désactivée si l'utilisateur préfère réduire les animations.", "default": true },

    { "type": "header", "content": "Coupes immersives (penché)" },
    { "type": "range", "id": "cut_depth", "label": "Inclinaison", "unit": "%", "min": 0, "max": 20, "step": 1, "default": 8 },
    { "type": "select", "id": "cut_direction", "label": "Sens de l'inclinaison", "options": [
      { "value": "right", "label": "Montant vers la droite" }, { "value": "left", "label": "Montant vers la gauche" } ], "default": "right" },
    { "type": "range", "id": "under_footer", "label": "Glisser sous la forêt du pied de page", "unit": "px", "min": 0, "max": 200, "step": 10, "default": 0, "info": "0 = la bande s'arrête au-dessus du pied de page." },
    { "type": "checkbox", "id": "cut_bottom", "label": "Pencher aussi le bas", "info": "Décoché : le bas reste droit, pour que la forêt du pied de page recouvre la bande.", "default": true },

    { "type": "header", "content": "Mise en page" },
    { "type": "range", "id": "min_height", "label": "Hauteur (bureau)", "unit": "px", "min": 280, "max": 1400, "step": 20, "default": 420 },
    { "type": "range", "id": "height_mobile", "label": "Hauteur (mobile)", "unit": "px", "min": 240, "max": 600, "step": 10, "default": 420 },

    { "type": "header", "content": "Couleurs" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleur", "default": "scheme-1" },
    { "type": "color", "id": "accent_color", "label": "Couleur du sur-titre", "default": "#f4d694" },
    { "type": "color", "id": "title_color", "label": "Couleur du titre", "default": "#fcf9f1" },
    { "type": "color", "id": "button_bg", "label": "Fond du bouton", "default": "#f4d694" },
    { "type": "color", "id": "button_text", "label": "Texte du bouton", "default": "#623c3c" },

    { "type": "header", "content": "Marges" },
    { "type": "range", "id": "padding_top", "label": "Marge haut", "unit": "px", "min": 0, "max": 200, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Marge bas", "unit": "px", "min": 0, "max": 200, "step": 4, "default": 40 },

    { "type": "header", "content": "Ancre" },
    { "type": "text", "id": "anchor_id", "label": "Ancre (ID)", "info": "Sans espace ni accent." }
  ],
  "presets": [
    { "name": "RDC — CTA final" }
  ]
}
{% endschema %}
