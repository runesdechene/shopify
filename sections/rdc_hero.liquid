{%- comment -%}
  rdc_hero.liquid

  Hero de la home Boutique : diaporama d'IMAGES DE FOND (un bloc = une image),
  avec le CONTENU FIXE par-dessus (overline, titre, sous-titre, 2 CTA) qui ne
  change pas d'une image a l'autre.

  - Images en blocs "slide" (desktop + mobile optionnel).
  - Crossfade automatique, desactive si une seule image ou prefers-reduced-motion.
  - S'appuie sur les tokens du theme (polices, boutons, schemas de couleur).
{%- endcomment -%}

{%- liquid
  assign uid = 'RdcHero-' | append: section.id
  assign overlay_r = section.settings.overlay_color | color_extract: 'red'
  assign overlay_g = section.settings.overlay_color | color_extract: 'green'
  assign overlay_b = section.settings.overlay_color | color_extract: 'blue'
  assign overlay_a = section.settings.overlay_opacity | divided_by: 100.0
  assign shadow_a = section.settings.text_shadow | divided_by: 100.0
  assign interval_ms = section.settings.autoplay_interval | times: 1000

  assign align_items = 'flex-end'
  assign pad_block = '0 9vh'
  if section.settings.content_vertical == 'top'
    assign align_items = 'flex-start'
    assign pad_block = '13vh 0'
  elsif section.settings.content_vertical == 'center'
    assign align_items = 'center'
    assign pad_block = '6vh'
  endif

  assign inner_ml = '0'
  assign inner_mr = 'auto'
  if section.settings.content_horizontal == 'center'
    assign inner_ml = 'auto'
    assign inner_mr = 'auto'
  elsif section.settings.content_horizontal == 'right'
    assign inner_ml = 'auto'
    assign inner_mr = '0'
  endif

  assign talign = section.settings.content_text_align | default: section.settings.content_horizontal
  assign text_align = 'left'
  assign actions_justify = 'flex-start'
  assign sub_mx_l = '0'
  assign sub_mx_r = 'auto'
  if talign == 'center'
    assign text_align = 'center'
    assign actions_justify = 'center'
    assign sub_mx_l = 'auto'
    assign sub_mx_r = 'auto'
  elsif talign == 'right'
    assign text_align = 'right'
    assign actions_justify = 'flex-end'
    assign sub_mx_l = 'auto'
    assign sub_mx_r = '0'
  endif

  assign mobile_vjustify = 'center'
  if section.settings.mobile_vertical == 'top'
    assign mobile_vjustify = 'flex-start'
  elsif section.settings.mobile_vertical == 'bottom'
    assign mobile_vjustify = 'flex-end'
  endif
-%}

<style>
  #{{ uid }}{
    position:relative;
    display:flex;
    min-height:{{ section.settings.min_height }}vh;
    --rdchero-shadow:0 2px 24px rgba(0,0,0,{{ shadow_a }});
    align-items:{{ align_items }};
    text-align:{{ text_align }};
  }
  #{{ uid }}-bg .rdchero__slides{position:absolute;inset:0;overflow:hidden;background:#1c1812}
  #{{ uid }}-bg .rdchero__slide{position:absolute;inset:0;opacity:0;transition:opacity 1.2s ease-in-out}
  #{{ uid }}-bg .rdchero__slide.is-active{opacity:1}
  #{{ uid }}-bg .rdchero__slide picture{position:absolute;inset:0;display:block;width:100%;height:100%}
  #{{ uid }}-bg .rdchero__slide img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}
  {%- if section.settings.ken_burns -%}
  #{{ uid }}-bg .rdchero__slide.is-active img{animation:rdcheroKenBurns {{ section.settings.ken_burns_duration }}s ease-in-out infinite alternate;will-change:transform}
  @keyframes rdcheroKenBurns{from{transform:scale(1.03) translate3d(0,0,0)}to{transform:scale(1.10) translate3d(-1.8%,-1.2%,0)}}
  {%- endif -%}
  /* scrim degrade (lisibilite) + overlay couleur reglable */
  #{{ uid }}-bg .rdchero__scrim{position:absolute;inset:0;pointer-events:none;
    background:
      linear-gradient(180deg, rgba(0,0,0,.18) 0%, rgba(0,0,0,0) 38%, rgba(0,0,0,.62) 100%),
      rgba({{ overlay_r }},{{ overlay_g }},{{ overlay_b }},{{ overlay_a }});}
  #{{ uid }} .rdchero__content{position:relative;width:100%;
    padding-inline:{{ section.settings.content_padding_x }}px;
    padding-block:{{ pad_block }};}
  #{{ uid }} .rdchero__inner{max-width:{{ section.settings.content_max_width }}ch;
    margin-left:{{ inner_ml }};margin-right:{{ inner_mr }};}
  #{{ uid }} .rdchero__overline{font-family:var(--font-body--family);font-weight:700;
    font-size:.74rem;letter-spacing:.26em;text-transform:uppercase;
    color:{{ section.settings.overline_color }};margin-bottom:16px}
  #{{ uid }} .rdchero__title{font-family:var(--font-heading--family, sans-serif);
    color:{{ section.settings.text_color }};text-transform:uppercase;line-height:.94;letter-spacing:.02em;
    font-size:clamp(2.2rem,5.2vw,4.6rem);text-shadow:var(--rdchero-shadow);margin:0}
  #{{ uid }} .rdchero__title2{font-family:var(--font-heading--family, sans-serif);
    color:{{ section.settings.text_color }};text-transform:uppercase;line-height:.98;letter-spacing:.02em;
    font-size:clamp(1.4rem,3vw,2.6rem);opacity:.92;text-shadow:var(--rdchero-shadow);margin:8px 0 0}
  #{{ uid }} .rdchero__subtitle{font-family:var(--font-body--family);
    color:{{ section.settings.text_color }};font-size:clamp(1rem,1.4vw,1.18rem);line-height:1.5;
    max-width:48ch;margin:18px {{ sub_mx_r }} 0 {{ sub_mx_l }};text-shadow:var(--rdchero-shadow)}
  #{{ uid }} .rdchero__subtitle p{margin:0}
  #{{ uid }} .rdchero__actions{display:flex;flex-wrap:wrap;gap:13px;margin-top:30px;
    justify-content:{{ actions_justify }};}
  /* Style harmonisé des CTA — contour clair (style "Rejoindre la communauté") */
  #{{ uid }} .rdchero__btn{display:inline-flex;align-items:center;font-family:var(--font-body--family);
    font-weight:700;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;
    padding:14px 30px;border-radius:12px;
    color:#fff;border:1px solid rgba(255,255,255,.6);text-decoration:none;transition:.2s;background:transparent}
  #{{ uid }} .rdchero__btn:hover{background:#fff;color:#222;border-color:#fff}
  /* CTA principal : doré (signature marque), s'éclaircit au survol */
  #{{ uid }} .rdchero__btn--solid{background:#f4d694;color:#623c3c;border-color:#f4d694}
  #{{ uid }} .rdchero__btn--solid:hover{background:#f9e6bd;color:#623c3c;border-color:#f9e6bd}
  /* Points de navigation du diaporama */
  #{{ uid }} .rdchero__dots{position:absolute;left:0;right:0;bottom:22px;z-index:3;
    display:flex;justify-content:center;gap:10px;pointer-events:none}
  #{{ uid }} .rdchero__dot{pointer-events:auto;width:9px;height:9px;padding:0;border:0;cursor:pointer;
    border-radius:50%;background:rgba(255,255,255,.45);transition:.25s ease;box-shadow:0 1px 4px rgba(0,0,0,.35)}
  #{{ uid }} .rdchero__dot:hover{background:rgba(255,255,255,.8)}
  #{{ uid }} .rdchero__dot.is-active{background:#fff;width:26px;border-radius:5px}
  #{{ uid }}-bg .rdchero__placeholder{display:flex;align-items:center;justify-content:center;
    position:absolute;inset:0;background:linear-gradient(135deg,#55584a,#2b2d23);color:#e9e0cb;
    font-family:var(--font-body--family);font-size:.9rem;text-align:center;padding:20px}

  @media (max-width:749px){
    #{{ uid }}{min-height:{{ section.settings.min_height_mobile }}vh}
    #{{ uid }} .rdchero__content{position:absolute;inset:0;display:flex;flex-direction:column;
      justify-content:{{ mobile_vjustify }};
      padding-inline:24px;
      padding-block:max(calc(var(--header-group-height, 0px) + 16px), 88px) 52px}
    #{{ uid }} .rdchero__overline{font-size:.66rem;letter-spacing:.18em;margin-bottom:12px}
    #{{ uid }} .rdchero__title{font-size:{{ section.settings.mobile_title_size }}px;line-height:.98}
    #{{ uid }} .rdchero__title2{font-size:calc({{ section.settings.mobile_title_size }}px * 0.56);margin-top:6px}
    #{{ uid }} .rdchero__subtitle{font-size:1rem;line-height:1.5;margin-top:14px;max-width:42ch}
    {% if section.settings.mobile_hide_subtitle %}#{{ uid }} .rdchero__subtitle{display:none}{% endif %}
    #{{ uid }} .rdchero__actions{gap:10px;margin-top:24px}
    #{{ uid }} .rdchero__btn{padding:13px 24px;font-size:.8rem}
  }
  @media (prefers-reduced-motion: reduce){
    #{{ uid }} .rdchero__slide{transition:none}
    #{{ uid }}-bg .rdchero__slide img{animation:none!important;transform:none!important}
  }
</style>

<div id="{{ uid }}-bg" class="section-background color-{{ section.settings.color_scheme }} rdchero__bg">
  <div class="rdchero__slides">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign img_m = block.settings.image_mobile
          if forloop.first
            assign loading = 'eager'
            assign fetch = 'high'
          else
            assign loading = 'lazy'
            assign fetch = 'auto'
          endif
        -%}
        <div class="rdchero__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            <picture>
              {%- if img_m != blank -%}
                <source media="(max-width:749px)"
                  srcset="{{ img_m | image_url: width: 600 }} 600w, {{ img_m | image_url: width: 900 }} 900w, {{ img_m | image_url: width: 1200 }} 1200w"
                  sizes="100vw">
              {%- endif -%}
              <img
                src="{{ img | image_url: width: 1600 }}"
                srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w, {{ img | image_url: width: 2600 }} 2600w"
                sizes="100vw"
                width="{{ img.width }}" height="{{ img.height }}"
                alt="{{ img.alt | escape }}"
                loading="{{ loading }}" fetchpriority="{{ fetch }}" decoding="async">
            </picture>
          {%- else -%}
            <div class="rdchero__placeholder">Ajoute une image à ce bloc « Image »</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="rdchero__placeholder">Ajoute des blocs « Image » pour démarrer le diaporama du hero.</div>
    {%- endif -%}
  </div>
  <div class="rdchero__scrim"></div>
</div>

<div id="{{ uid }}" class="rdchero section section--full-width color-{{ section.settings.color_scheme }}" data-rdchero data-interval="{{ interval_ms }}" data-autoplay="{{ section.settings.autoplay }}">

  <div class="rdchero__content">
    <div class="rdchero__inner">
      {%- if section.settings.overline != blank -%}
        <div class="rdchero__overline">{{ section.settings.overline }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 class="rdchero__title">{{ section.settings.title }}</h1>
      {%- endif -%}
      {%- if section.settings.title_2 != blank -%}
        <p class="rdchero__title2">{{ section.settings.title_2 }}</p>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="rdchero__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      {%- if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank -%}
        <div class="rdchero__actions">
          {%- if section.settings.cta_primary_label != blank -%}
            <a class="rdchero__btn rdchero__btn--solid" href="{{ section.settings.cta_primary_url | default: '#' }}">{{ section.settings.cta_primary_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_label != blank -%}
            <a class="rdchero__btn" href="{{ section.settings.cta_secondary_url | default: '#' }}">{{ section.settings.cta_secondary_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- if section.blocks.size > 1 and section.settings.show_dots -%}
    <div class="rdchero__dots" aria-label="Navigation des images">
      {%- for block in section.blocks -%}
        <button type="button" class="rdchero__dot{% if forloop.first %} is-active{% endif %}" data-rdc-dot="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function(){
    var root = document.getElementById('{{ uid }}');
    if(!root) return;
    if(root._rdcHeroTimer){ clearInterval(root._rdcHeroTimer); root._rdcHeroTimer = null; }
    var bg = document.getElementById('{{ uid }}-bg');
    var slides = bg ? bg.querySelectorAll('.rdchero__slide') : [];
    var dots = root.querySelectorAll('.rdchero__dot');
    if(slides.length < 2) return;
    var i = 0;
    function goTo(n){
      slides[i].classList.remove('is-active');
      if(dots[i]) dots[i].classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-active');
      if(dots[i]) dots[i].classList.add('is-active');
    }
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var autoplay = root.dataset.autoplay === 'true' && !reduce;
    var interval = parseInt(root.dataset.interval, 10) || 5000;
    function start(){ if(autoplay){ root._rdcHeroTimer = setInterval(function(){ goTo(i + 1); }, interval); } }
    function stop(){ if(root._rdcHeroTimer){ clearInterval(root._rdcHeroTimer); root._rdcHeroTimer = null; } }
    for(var d = 0; d < dots.length; d++){
      (function(idx){
        dots[idx].addEventListener('click', function(){ stop(); goTo(idx); start(); });
      })(d);
    }
    start();
  })();
</script>

{% schema %}
{
  "name": "RDC — Hero diaporama",
  "tag": "section",
  "class": "rdchero-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Contenu fixe (au-dessus des images)" },
    { "type": "inline_richtext", "id": "overline", "label": "Sur-titre", "default": "Runes de Chêne · le mouvement" },
    { "type": "inline_richtext", "id": "title", "label": "Titre principal", "default": "Porte un Fragment d'Histoire." },
    { "type": "inline_richtext", "id": "title_2", "label": "Titre secondaire (plus petit, en dessous)", "default": "Deviens un aventurier de ton territoire." },
    { "type": "richtext", "id": "subtitle", "label": "Sous-titre", "default": "<p>Des vêtements illustrés à la main — chacun un écho du passé qui mérite d'être porté. Rejoins le mouvement des aventuriers du patrimoine.</p>" },
    { "type": "text", "id": "cta_primary_label", "label": "CTA principal — texte", "default": "Découvrir les Fragments" },
    { "type": "url", "id": "cta_primary_url", "label": "CTA principal — lien" },
    { "type": "text", "id": "cta_secondary_label", "label": "CTA secondaire — texte", "default": "Rejoindre la communauté" },
    { "type": "url", "id": "cta_secondary_url", "label": "CTA secondaire — lien" },

    { "type": "header", "content": "Mise en page" },
    { "type": "select", "id": "content_vertical", "label": "Position verticale", "options": [
      { "value": "top", "label": "Haut" }, { "value": "center", "label": "Centre" }, { "value": "bottom", "label": "Bas" } ], "default": "bottom" },
    { "type": "select", "id": "content_horizontal", "label": "Position horizontale du bloc", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" } ], "default": "left" },
    { "type": "select", "id": "content_text_align", "label": "Alignement du texte & boutons", "options": [
      { "value": "", "label": "Auto (suit la position)" }, { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" } ], "default": "" },
    { "type": "range", "id": "content_max_width", "label": "Largeur max du texte (caractères)", "min": 20, "max": 60, "step": 1, "default": 26 },
    { "type": "range", "id": "content_padding_x", "label": "Marge horizontale du contenu", "unit": "px", "min": 0, "max": 200, "step": 4, "default": 56 },
    { "type": "range", "id": "min_height", "label": "Hauteur (desktop)", "unit": "vh", "min": 40, "max": 100, "step": 2, "default": 84 },
    { "type": "range", "id": "min_height_mobile", "label": "Hauteur (mobile)", "unit": "vh", "min": 40, "max": 100, "step": 2, "default": 80 },

    { "type": "header", "content": "📱 Réglages mobile" },
    { "type": "select", "id": "mobile_vertical", "label": "Position verticale (mobile)", "options": [
      { "value": "top", "label": "Haut" }, { "value": "center", "label": "Centre" }, { "value": "bottom", "label": "Bas" } ], "default": "center" },
    { "type": "range", "id": "mobile_title_size", "label": "Taille du titre (mobile)", "unit": "px", "min": 22, "max": 56, "step": 2, "default": 38 },
    { "type": "checkbox", "id": "mobile_hide_subtitle", "label": "Masquer le sous-titre sur mobile", "default": false },

    { "type": "header", "content": "Couleurs & overlay" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleur (fond si pas d'image)", "default": "scheme-3" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte", "default": "#ffffff" },
    { "type": "color", "id": "overline_color", "label": "Couleur du sur-titre", "default": "#f4d694" },
    { "type": "color", "id": "overlay_color", "label": "Couleur de l'overlay", "default": "#140f0c" },
    { "type": "range", "id": "overlay_opacity", "label": "Intensité de l'overlay", "unit": "%", "min": 0, "max": 90, "step": 5, "default": 40 },
    { "type": "range", "id": "text_shadow", "label": "Ombre du texte", "unit": "%", "min": 0, "max": 100, "step": 5, "default": 30 },

    { "type": "header", "content": "Diaporama" },
    { "type": "checkbox", "id": "autoplay", "label": "Défilement automatique", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Points de navigation", "default": true },
    { "type": "range", "id": "autoplay_interval", "label": "Durée par image", "unit": "s", "min": 3, "max": 10, "step": 1, "default": 5 },

    { "type": "header", "content": "Animation de la photo" },
    { "type": "checkbox", "id": "ken_burns", "label": "Effet de mouvement (zoom lent)", "default": true },
    { "type": "range", "id": "ken_burns_duration", "label": "Durée du mouvement", "unit": "s", "min": 10, "max": 60, "step": 2, "default": 24 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile) — optionnel" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RDC — Hero diaporama",
      "blocks": [ { "type": "slide" }, { "type": "slide" } ]
    }
  ]
}
{% endschema %}
