{%- comment -%}
  rdc_collections.liquid — « RDC — Sagas »

  Tuiles de collections (sagas) : photo avec le titre GRAVÉ dedans, + accroche
  en VRAI texte HTML (Bebas Neue = police de titres du thème).

  Pourquoi le titre est gravé : chaque saga a sa fonte décorative, et le titre
  doit épouser les couleurs et le grain de la photo — une superposition HTML ou
  PNG reste toujours posée par-dessus. Décision d'Uriel, 2026-08-05.

  Le titre existe quand même en HTML, mais hors écran (.rdc-saga__sr) : Google
  et les lecteurs d'écran le lisent. Il doit donc être saisi à l'identique.

  L'accroche, elle, reste éditable en trois secondes depuis l'éditeur — c'est
  le texte qui bouge, le titre ne bouge presque jamais.

  Remplace l'usage de la section native `collection-list` sur la home.
{%- endcomment -%}

{%- liquid
  assign uid = 'RdcSaga-' | append: section.id
  assign ratio = '1 / 1'
  case section.settings.tile_ratio
    when 'portrait'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'wide'
      assign ratio = '16 / 9'
  endcase
-%}

<style>
  #{{ uid }} .rdc-saga__inner{min-width:0;
    padding-block:{{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px}
  #{{ uid }} .rdc-saga__head{text-align:{{ section.settings.text_align }};margin-bottom:clamp(26px,3vw,40px)}
  #{{ uid }} .rdc-saga__overline{font-family:var(--font-body--family);font-weight:700;
    font-size:.74rem;letter-spacing:.26em;text-transform:uppercase;
    color:{{ section.settings.accent_color }};margin-bottom:10px}
  #{{ uid }} .rdc-saga__heading{font-family:var(--font-heading--family, sans-serif);text-transform:uppercase;
    font-size:clamp(1.8rem,3.2vw,2.6rem);letter-spacing:.04em;line-height:1;
    color:var(--color-foreground-heading, #403434)}

  #{{ uid }} .rdc-saga__grid{display:grid;width:100%;
    grid-template-columns:repeat({{ section.settings.columns }},1fr);gap:{{ section.settings.gap }}px}
  #{{ uid }} .rdc-saga__tile{position:relative;display:block;overflow:hidden;text-decoration:none;
    border-radius:{{ section.settings.corner_radius }}px;aspect-ratio:{{ ratio }};background:#1c1812}
  #{{ uid }} .rdc-saga__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;
    transition:transform .6s ease}
  {% if section.settings.hover_zoom %}#{{ uid }} .rdc-saga__tile:hover .rdc-saga__img{transform:scale(1.06)}{% endif %}

  {%- comment -%}
    Pas d'overlay ici : l'assombrissement est traité DANS la photo, pour ne pas
    ternir le titre qui y est gravé. Décision d'Uriel, 2026-08-05.
  {%- endcomment -%}

  #{{ uid }} .rdc-saga__caption{position:absolute;inset:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:12px;padding:22px 20px;text-align:center}
  #{{ uid }} .rdc-saga__title-h{margin:0;display:flex;justify-content:center;width:100%}
  #{{ uid }} .rdc-saga__title-txt{display:block;color:#fff;text-transform:uppercase;
    font-family:var(--font-heading--family, sans-serif);
    font-size:clamp(1.3rem,2vw,1.9rem);letter-spacing:.06em;line-height:1;
    text-shadow:0 2px 14px rgba(0,0,0,.45)}

  {%- comment -%}
    Accroche : vrai texte HTML (Bebas Neue), pas gravée dans la photo — c'est le
    texte qui bouge, et gravé il devient illisible sur mobile.
    `mix-blend-mode` lui fait prendre les couleurs du fond : l'intégration
    visuelle du gravé, sans en payer le prix.
  {%- endcomment -%}
  #{{ uid }} .rdc-saga__sub{position:absolute;left:20px;right:20px;bottom:22px;
    display:block;font-family:var(--font-heading--family, sans-serif);
    text-transform:uppercase;color:{{ section.settings.sub_color }};
    font-size:{{ section.settings.sub_size }}rem;letter-spacing:.10em;line-height:1.25;
    opacity:{{ section.settings.sub_opacity | divided_by: 100.0 }};
    mix-blend-mode:{{ section.settings.sub_blend }};
    {% if section.settings.sub_shadow %}text-shadow:0 1px 10px rgba(0,0,0,.55){% endif %}}

  {%- comment -%}
    Pastille « nouveau » : coin haut, hors de la zone titre/accroche.
    Quatre styles. Le lettrage très espacé et la petite taille font le premium —
    un aplat épais avec ombre portée fait étiquette de promo.
  {%- endcomment -%}
  #{{ uid }} .rdc-saga__new{position:absolute;top:16px;{{ section.settings.new_align }}:16px;z-index:2;
    display:inline-flex;align-items:center;gap:7px;
    font-family:var(--font-heading--family, sans-serif);text-transform:uppercase;
    font-size:.72rem;letter-spacing:.20em;line-height:1;white-space:nowrap}
  #{{ uid }} .rdc-saga__new-dot{font-size:.52em;opacity:.85;transform:translateY(-.5px)}

  {%- case section.settings.new_style -%}
    {%- when 'solid' -%}
      #{{ uid }} .rdc-saga__new{padding:7px 15px;border-radius:999px;
        background:{{ section.settings.new_bg }};color:{{ section.settings.new_color }}}
    {%- when 'outline' -%}
      {%- comment -%} Filet fin, fond nu : le plus éditorial. {%- endcomment -%}
      #{{ uid }} .rdc-saga__new{padding:7px 15px;border-radius:999px;
        background:transparent;color:{{ section.settings.new_accent }};
        border:1px solid {{ section.settings.new_accent }};
        text-shadow:0 1px 8px rgba(0,0,0,.5)}
    {%- when 'glass' -%}
      {%- comment -%} Voile sombre flouté + filet clair : tient sur n'importe quelle photo. {%- endcomment -%}
      #{{ uid }} .rdc-saga__new{padding:7px 15px;border-radius:999px;
        background:rgba(20,16,12,.42);color:{{ section.settings.new_accent }};
        border:1px solid rgba(255,255,255,.22);
        -webkit-backdrop-filter:blur(9px) saturate(130%);backdrop-filter:blur(9px) saturate(130%)}
    {%- when 'bare' -%}
      {%- comment -%} Aucun contenant : juste le mot. Le plus discret, le plus sûr de goût. {%- endcomment -%}
      #{{ uid }} .rdc-saga__new{padding:0;background:none;border:0;
        color:{{ section.settings.new_accent }};letter-spacing:.26em;
        text-shadow:0 1px 10px rgba(0,0,0,.75)}
  {%- endcase -%}

  #{{ uid }} .rdc-saga__placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,#55584a,#2b2d23);color:#e9e0cb;
    font-family:var(--font-body--family);font-size:.85rem;text-align:center;padding:16px}
  #{{ uid }} .rdc-saga__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

  @media (max-width:749px){
    #{{ uid }} .rdc-saga__grid{grid-template-columns:repeat({{ section.settings.columns_mobile }},1fr);
      gap:{{ section.settings.gap | divided_by: 2 }}px}
    #{{ uid }} .rdc-saga__sub{font-size:{{ section.settings.sub_size | times: 0.85 }}rem;letter-spacing:.07em}
    #{{ uid }} .rdc-saga__caption{padding:16px 14px}
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div id="{{ uid }}" class="section section--page-width color-{{ section.settings.color_scheme }} rdc-saga">
  <div class="rdc-saga__inner">
    {%- if section.settings.overline != blank or section.settings.title != blank -%}
      <div class="rdc-saga__head">
        {%- if section.settings.overline != blank -%}
          <div class="rdc-saga__overline">{{ section.settings.overline }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <div class="rdc-saga__heading">{{ section.settings.title }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="rdc-saga__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign coll = block.settings.collection
            assign img = block.settings.image | default: coll.image
            assign title_txt = block.settings.title_text | default: coll.title
            assign sub = block.settings.subtitle
            assign url = block.settings.link | default: coll.url
            if url == blank
              assign url = '#'
            endif

            comment
              Pastille « nouveau », calculée : on prend la date de publication la
              plus récente de la collection et on l'affiche si elle tient dans la
              fenêtre réglée. Elle s'éteint donc toute seule — aucune pastille
              périmée qui traîne. (coll.products plafonne à 50 en section : sans
              effet ici, les collections sont bien en dessous.)
            endcomment
            assign show_new = false
            assign new_label = block.settings.new_text | default: section.settings.new_text
            if block.settings.new_mode == 'always'
              assign show_new = true
            elsif block.settings.new_mode == 'never'
              assign show_new = false
            elsif section.settings.show_new and coll != blank
              assign newest = 0
              for product in coll.products
                assign pub = product.published_at | date: '%s' | plus: 0
                if pub > newest
                  assign newest = pub
                endif
              endfor
              if newest > 0
                assign now_s = 'now' | date: '%s' | plus: 0
                assign age_days = now_s | minus: newest | divided_by: 86400
                if age_days <= section.settings.new_days
                  assign show_new = true
                endif
              endif
            endif
            if new_label == blank
              assign show_new = false
            endif
          -%}
          <a class="rdc-saga__tile" href="{{ url }}" {{ block.shopify_attributes }}>
            {%- if img != blank -%}
              <img class="rdc-saga__img"
                src="{{ img | image_url: width: 900 }}"
                srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1300 }} 1300w"
                sizes="(min-width: 750px) {{ 100 | divided_by: section.settings.columns }}vw, 100vw"
                width="{{ img.width }}" height="{{ img.height }}"
                alt="" loading="lazy" decoding="async">
            {%- else -%}
              <div class="rdc-saga__placeholder">Choisis une collection (ou ajoute une image de fond)</div>
            {%- endif -%}

            {%- if show_new -%}
              <span class="rdc-saga__new">
                {%- if section.settings.new_marker -%}<span class="rdc-saga__new-dot" aria-hidden="true">◆</span>{%- endif -%}
                <span>{{ new_label }}</span>
              </span>
            {%- endif -%}

            <div class="rdc-saga__caption">
              {%- comment -%}
                Le titre est gravé DANS la photo (intégration des couleurs et du
                grain). Il existe quand même en HTML, mais hors écran : Google et
                les lecteurs d'écran le lisent, l'œil ne le voit pas.
                → Le texte saisi ici doit être EXACTEMENT celui de l'image.
              {%- endcomment -%}
              {%- if title_txt != blank -%}
                <h3 class="rdc-saga__title-h{% unless block.settings.title_visible %} rdc-saga__sr{% endunless %}">
                  <span class="rdc-saga__title-txt">{{ title_txt }}</span>
                </h3>
              {%- endif -%}

              {%- if sub != blank -%}
                <span class="rdc-saga__sub">{{ sub }}</span>
              {%- endif -%}

              {%- if title_txt == blank and sub == blank -%}
                <span class="rdc-saga__sr">{{ coll.title }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "RDC — Sagas",
  "tag": "section",
  "class": "rdc-collections-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Titre de section (optionnel)" },
    { "type": "inline_richtext", "id": "overline", "label": "Sur-titre" },
    { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Nos collections" },

    { "type": "header", "content": "Grille" },
    { "type": "range", "id": "columns", "label": "Colonnes (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Colonnes (mobile)", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "select", "id": "tile_ratio", "label": "Format des tuiles", "options": [
      { "value": "square", "label": "Carré" },
      { "value": "portrait", "label": "Portrait (3:4)" },
      { "value": "landscape", "label": "Paysage (4:3)" },
      { "value": "wide", "label": "Large (16:9)" } ], "default": "square" },
    { "type": "range", "id": "gap", "label": "Espacement", "unit": "px", "min": 4, "max": 40, "step": 2, "default": 20 },
    { "type": "range", "id": "corner_radius", "label": "Arrondi des coins", "unit": "px", "min": 0, "max": 30, "step": 1, "default": 0 },
    { "type": "checkbox", "id": "hover_zoom", "label": "Zoom au survol", "default": true },

    { "type": "header", "content": "Pastille « nouveau »" },
    { "type": "checkbox", "id": "show_new", "label": "Afficher automatiquement", "default": true, "info": "S'allume quand la collection a reçu un Fragment récemment, et s'éteint toute seule après." },
    { "type": "range", "id": "new_days", "label": "Pendant combien de jours", "unit": "j", "min": 5, "max": 90, "step": 5, "default": 30 },
    { "type": "text", "id": "new_text", "label": "Texte", "default": "Nouveau Fragment" },
    { "type": "select", "id": "new_align", "label": "Coin", "options": [
      { "value": "left", "label": "Haut gauche" },
      { "value": "right", "label": "Haut droite" } ], "default": "left" },
    { "type": "select", "id": "new_style", "label": "Style", "options": [
      { "value": "glass", "label": "Voilé — filet clair sur fond flouté" },
      { "value": "outline", "label": "Filet seul — le plus éditorial" },
      { "value": "bare", "label": "Sans contenant — juste le mot" },
      { "value": "solid", "label": "Plein — le plus visible" } ], "default": "glass" },
    { "type": "checkbox", "id": "new_marker", "label": "Losange devant le texte", "default": true },
    { "type": "color", "id": "new_accent", "label": "Couleur du texte et du filet", "default": "#e8cd9a", "info": "Styles Voilé, Filet seul et Sans contenant." },
    { "type": "color", "id": "new_bg", "label": "Fond (style Plein)", "default": "#b4894f" },
    { "type": "color", "id": "new_color", "label": "Texte (style Plein)", "default": "#1c1812" },

    { "type": "header", "content": "Accroche" },
    { "type": "color", "id": "sub_color", "label": "Couleur", "default": "#f2e6d2" },
    { "type": "range", "id": "sub_size", "label": "Taille", "unit": "rem", "min": 0.7, "max": 1.6, "step": 0.1, "default": 1.0 },
    { "type": "select", "id": "sub_blend", "label": "Fusion avec la photo", "options": [
      { "value": "normal", "label": "Aucune (texte posé dessus)" },
      { "value": "soft-light", "label": "Lumière douce — la plus subtile" },
      { "value": "overlay", "label": "Incrustation — prend les couleurs du fond" },
      { "value": "screen", "label": "Superposition claire" },
      { "value": "luminosity", "label": "Luminosité" } ], "default": "normal", "info": "Fond le texte dans le grain et les couleurs de la photo, comme s'il y était gravé." },
    { "type": "range", "id": "sub_opacity", "label": "Opacité", "unit": "%", "min": 20, "max": 100, "step": 5, "default": 100 },
    { "type": "checkbox", "id": "sub_shadow", "label": "Ombre portée", "default": true, "info": "À décocher si tu utilises une fusion." },

    { "type": "header", "content": "Mise en page" },
    { "type": "select", "id": "text_align", "label": "Alignement du titre de section", "options": [
      { "value": "left", "label": "Gauche" },
      { "value": "center", "label": "Centre" } ], "default": "left" },
    { "type": "range", "id": "padding_top", "label": "Marge haut", "unit": "px", "min": 0, "max": 160, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Marge bas", "unit": "px", "min": 0, "max": 160, "step": 4, "default": 72 },

    { "type": "header", "content": "Couleurs" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleur", "default": "scheme-1" },
    { "type": "color", "id": "accent_color", "label": "Couleur du sur-titre", "default": "#b4894f" }
  ],
  "blocks": [
    {
      "type": "saga",
      "name": "Saga",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Photo (titre gravé dedans)", "info": "Sinon, image de la collection." },
        { "type": "text", "id": "title_text", "label": "Titre en toutes lettres", "info": "Invisible à l'écran, lu par Google et les lecteurs d'écran. Doit être EXACTEMENT le titre gravé dans la photo." },
        { "type": "checkbox", "id": "title_visible", "label": "Afficher le titre par-dessus la photo", "default": false, "info": "À cocher seulement si la photo n'a pas de titre gravé (dépannage)." },
        { "type": "text", "id": "subtitle", "label": "Accroche (une phrase)" },
        { "type": "url", "id": "link", "label": "Lien (sinon la collection)" },
        { "type": "header", "content": "Pastille « nouveau »" },
        { "type": "select", "id": "new_mode", "label": "Comportement", "options": [
          { "value": "auto", "label": "Automatique (recommandé)" },
          { "value": "always", "label": "Toujours afficher" },
          { "value": "never", "label": "Ne jamais afficher" } ], "default": "auto" },
        { "type": "text", "id": "new_text", "label": "Texte (sinon celui de la section)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RDC — Sagas",
      "blocks": [ { "type": "saga" }, { "type": "saga" }, { "type": "saga" }, { "type": "saga" } ]
    }
  ]
}
{% endschema %}
