{%- comment -%}
  rdc_mur-vivant.liquid

  Section « Le mouvement est vivant » — beat 5 (preuve sociale) de la home Boutique.

  Carrousel mouvant de TOUTES les photos du mur communautaire (« ils nous portent »).
  - Données : vue Supabase `movement_wall_photos` (anon, PostgREST direct, pas de RPC).
  - 1 à 3 rangées (défaut 2) en sens opposés, défilement continu, pause au survol.
  - Robuste au petit volume : duplication pour boucle sans couture même avec 4 photos.
  - 0 photo OU config manquante → section masquée. prefers-reduced-motion → animation coupée.
  - Clic sur une photo → fiche lightbox (nom, @insta, avis, bouton produit).
  - Typo/couleurs via tokens du thème (--font-* / --color-*).
{%- endcomment -%}

{%- liquid
  assign uid = 'RdcMv-' | append: section.id
  assign s = section.settings
-%}

<style>
  #{{ uid }} {
    --mv-accent: {{ s.accent_color }};
    --mv-card-w: {{ s.card_width }}px;
    padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  #{{ uid }} .rdc-mv__head { text-align: center; max-width: 820px; margin: 0 auto; padding-inline: 24px; }
  #{{ uid }} .rdc-mv__over {
    font-family: var(--font-accent--family);
    font-size: .82rem; letter-spacing: .34em; text-transform: uppercase;
    color: var(--mv-accent); font-weight: 600; margin-bottom: 12px;
  }
  #{{ uid }} .rdc-mv__title {
    font-family: var(--font-heading--family); font-weight: 400;
    font-size: clamp(3rem, 7vw, 5.5rem); line-height: .92; letter-spacing: .02em;
    color: var(--color-foreground-heading, var(--color-foreground)); margin: 0;
  }
  #{{ uid }} .rdc-mv__sub {
    font-family: var(--font-body--family);
    margin-top: 16px; font-size: 1.06rem; line-height: 1.55;
    color: var(--color-foreground); opacity: .82;
  }

  /* Stats */
  #{{ uid }} .rdc-mv__stats { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; margin: 30px auto 4px; }
  #{{ uid }} .rdc-mv__stat { padding: 6px 30px; text-align: center; position: relative; }
  #{{ uid }} .rdc-mv__stat + .rdc-mv__stat::before {
    content: ""; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 1px; height: 38px; background: rgb(var(--color-foreground-rgb) / .18);
  }
  #{{ uid }} .rdc-mv__stat b {
    display: block; font-family: var(--font-heading--family); font-weight: 400;
    font-size: 2.5rem; line-height: 1; letter-spacing: .02em; color: var(--mv-accent);
  }
  #{{ uid }} .rdc-mv__stat span {
    display: block; font-family: var(--font-accent--family);
    font-size: .76rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--color-foreground); opacity: .7; margin-top: 6px;
  }
  #{{ uid }} .rdc-mv__stars { color: var(--mv-accent); font-size: 1.15rem; letter-spacing: 3px; line-height: 1; }

  /* Marquee */
  #{{ uid }} .rdc-mv__wall { margin-top: 36px; }
  #{{ uid }} .rdc-mv__status { text-align: center; opacity: .6; padding: 2.5rem 1rem; font-family: var(--font-body--family); color: var(--color-foreground); }
  #{{ uid }} .rdc-mv__row {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  #{{ uid }} .rdc-mv__row + .rdc-mv__row { margin-top: 14px; }
  #{{ uid }} .rdc-mv__track { display: flex; gap: 14px; width: max-content; will-change: transform; }
  #{{ uid }} .rdc-mv__row:hover .rdc-mv__track { animation-play-state: paused; }
  @keyframes rdcMvScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  #{{ uid }} .rdc-mv__ph {
    flex: 0 0 auto; width: var(--mv-card-w); aspect-ratio: 2/3;
    border-radius: 14px; overflow: hidden; position: relative; background: #221a12;
    cursor: pointer; box-shadow: 0 8px 22px rgb(var(--color-foreground-rgb) / .14);
  }
  #{{ uid }} .rdc-mv__ph img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  #{{ uid }} .rdc-mv__ph:hover img { transform: scale(1.06); }
  #{{ uid }} .rdc-mv__name {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 26px 12px 10px;
    background: linear-gradient(to top, rgba(0,0,0,.62), transparent);
    color: #fff; font-family: var(--font-accent--family); letter-spacing: .04em;
    font-size: .9rem; opacity: 0; transition: opacity .25s; pointer-events: none;
  }
  #{{ uid }} .rdc-mv__ph:hover .rdc-mv__name { opacity: 1; }

  /* Pied / lien soumission */
  #{{ uid }} .rdc-mv__foot { text-align: center; margin-top: 36px; padding-inline: 24px; }
  #{{ uid }} .rdc-mv__foot p {
    font-family: var(--font-fragment--family); font-style: italic;
    font-size: 1.05rem; color: var(--color-foreground); opacity: .8; margin: 0 0 10px;
  }
  #{{ uid }} .rdc-mv__submit {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-accent--family); letter-spacing: .04em; font-size: 1.05rem;
    color: var(--mv-accent); text-decoration: none; font-weight: 600;
    border-bottom: 1.5px solid rgb(var(--color-foreground-rgb) / .25); padding-bottom: 2px;
    transition: border-color .2s;
  }
  #{{ uid }} .rdc-mv__submit:hover { border-bottom-color: var(--mv-accent); }

  /* Lightbox — style galerie produit : grande image + overlay infos en bas */
  #{{ uid }} .rdc-mv__lb { display: none; position: fixed; inset: 0; z-index: 1000;
    background: rgba(20,12,6,.92); align-items: center; justify-content: center; padding: 4vh 4vw; }
  #{{ uid }} .rdc-mv__lb.is-open { display: flex; }
  #{{ uid }} .rdc-mv__lb-inner { position: relative; max-width: min(92vw, 720px); max-height: 92vh; }
  #{{ uid }} .rdc-mv__lb-img { display: block; max-width: 100%; max-height: 92vh; object-fit: contain; border-radius: 10px; }
  #{{ uid }} .rdc-mv__lb-overlay { position: absolute; left: 0; right: 0; bottom: 0; padding: 52px 24px 22px;
    background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.35) 55%, transparent 100%);
    color: #fff; border-radius: 0 0 10px 10px; pointer-events: none; }
  #{{ uid }} .rdc-mv__lb-overlay a { pointer-events: auto; }
  #{{ uid }} .rdc-mv__lb-name { font-family: var(--font-heading--family); font-weight: 400; font-size: 1.9rem;
    line-height: 1.12; letter-spacing: .02em; margin-bottom: 6px; }
  #{{ uid }} .rdc-mv__lb-verified { display: inline-flex; align-items: center; gap: 3px;
    font-family: var(--font-body--family); font-size: .66rem; font-weight: 600; letter-spacing: .02em;
    color: #d7f0d0; background: rgba(34,197,94,.22); border: 1px solid rgba(34,197,94,.55);
    padding: 2px 8px; border-radius: 999px; vertical-align: middle; white-space: nowrap; }
  #{{ uid }} .rdc-mv__lb-rating { font-size: .95rem; letter-spacing: .04em; margin-top: 2px; }
  #{{ uid }} .rdc-mv__lb-star-off { filter: grayscale(1); opacity: .4; }
  #{{ uid }} .rdc-mv__lb-msg { font-family: var(--font-fragment--family); font-style: italic;
    font-size: 1.02rem; line-height: 1.45; margin-top: 8px; opacity: .95; }
  #{{ uid }} .rdc-mv__lb-prod { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; margin-right: 8px;
    font-family: var(--font-accent--family); letter-spacing: .03em; font-size: .88rem; color: #fff;
    text-decoration: none; background: rgba(255,255,255,.16); padding: 8px 14px; border-radius: 999px; transition: background .2s; }
  #{{ uid }} .rdc-mv__lb-prod:hover { background: rgba(255,255,255,.30); }
  #{{ uid }} .rdc-mv__lb-close { position: absolute; top: -40px; right: 0; background: none; border: none;
    color: #fff; font-size: 2rem; line-height: 1; cursor: pointer; opacity: .85; }
  #{{ uid }} .rdc-mv__lb-close:hover { opacity: 1; }
  #{{ uid }} .rdc-mv__lb-nav { position: fixed; top: 50%; transform: translateY(-50%);
    width: 46px; height: 46px; border-radius: 50%; border: none; background: rgba(255,255,255,.16);
    color: #fff; font-size: 1.9rem; line-height: 1; cursor: pointer; padding: 0; display: flex;
    align-items: center; justify-content: center; z-index: 6; transition: background .2s; }
  #{{ uid }} .rdc-mv__lb-nav:hover { background: rgba(255,255,255,.32); }
  #{{ uid }} .rdc-mv__lb-nav--prev { left: max(2vw, 12px); }
  #{{ uid }} .rdc-mv__lb-nav--next { right: max(2vw, 12px); }
  #{{ uid }} .rdc-mv__lb-counter { position: absolute; bottom: 12px; right: 12px;
    background: rgba(0,0,0,.6); color: #fff; font-size: .78rem; letter-spacing: .03em;
    padding: 3px 10px; border-radius: 999px; }

  @media (max-width: 680px) {
    #{{ uid }} .rdc-mv__lb-nav { width: 38px; height: 38px; font-size: 1.5rem; }
    #{{ uid }} .rdc-mv__lb-name { font-size: 1.6rem; }
    #{{ uid }} .rdc-mv__stat { padding: 6px 18px; }
    #{{ uid }} .rdc-mv__stat b { font-size: 2rem; }
    #{{ uid }} { --mv-card-w: 150px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ uid }} .rdc-mv__track { animation: none !important; transform: none !important; }
    #{{ uid }} .rdc-mv__row { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  }
</style>

{%- if s.anchor_id != blank -%}<span id="{{ s.anchor_id }}" class="rdc-mv__anchor" aria-hidden="true" style="display:block;scroll-margin-top:var(--header-group-height,90px)"></span>{%- endif -%}
<div class="section-background color-{{ s.color_scheme }}"></div>
<div id="{{ uid }}" class="section section--full-width color-{{ s.color_scheme }} rdc-mv">

  {%- if s.overline != blank or s.title != blank or s.subtitle != blank or s.show_stats -%}
    <div class="rdc-mv__head">
      {%- if s.overline != blank -%}<div class="rdc-mv__over">{{ s.overline }}</div>{%- endif -%}
      {%- if s.title != blank -%}<h2 class="rdc-mv__title">{{ s.title }}</h2>{%- endif -%}
      {%- if s.subtitle != blank -%}<p class="rdc-mv__sub">{{ s.subtitle }}</p>{%- endif -%}

      {%- if s.show_stats -%}
        <div class="rdc-mv__stats">
          {%- if s.stat_rating_label != blank -%}
            <div class="rdc-mv__stat">
              {%- if s.show_stars -%}<div class="rdc-mv__stars">★★★★★</div>{%- endif -%}
              <span>{{ s.stat_rating_label }}</span>
            </div>
          {%- endif -%}
          {%- if s.stat2_value != blank -%}
            <div class="rdc-mv__stat"><b>{{ s.stat2_value }}</b><span>{{ s.stat2_label }}</span></div>
          {%- endif -%}
          {%- if s.stat3_value != blank -%}
            <div class="rdc-mv__stat"><b>{{ s.stat3_value }}</b><span>{{ s.stat3_label }}</span></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="rdc-mv__wall" id="{{ uid }}-wall"><p class="rdc-mv__status">Chargement du mur…</p></div>

  {%- if s.submit_label != blank and s.submit_url != blank -%}
    <div class="rdc-mv__foot">
      {%- if s.submit_intro != blank -%}<p>{{ s.submit_intro }}</p>{%- endif -%}
      <a class="rdc-mv__submit" href="{{ s.submit_url }}" target="_blank" rel="noopener">{{ s.submit_label }}</a>
    </div>
  {%- endif -%}

  <div class="rdc-mv__lb" id="{{ uid }}-lb">
    <button class="rdc-mv__lb-nav rdc-mv__lb-nav--prev" id="{{ uid }}-lb-prev" aria-label="Précédent">&#x2039;</button>
    <button class="rdc-mv__lb-nav rdc-mv__lb-nav--next" id="{{ uid }}-lb-next" aria-label="Suivant">&#x203A;</button>
    <div class="rdc-mv__lb-inner">
      <button class="rdc-mv__lb-close" aria-label="Fermer">&#x2715;</button>
      <img class="rdc-mv__lb-img" id="{{ uid }}-lb-img" src="" alt="">
      <div class="rdc-mv__lb-overlay" id="{{ uid }}-lb-overlay"></div>
      <span class="rdc-mv__lb-counter" id="{{ uid }}-lb-counter"></span>
    </div>
  </div>
</div>

<script>
  (function() {
    var UID = {{ uid | json }};
    /* Valeurs de secours (projet Supabase RDC, clé anon publique) si les réglages sont vides/mauvais. */
    var URL_FALLBACK = 'https://ukpapqssgsxirsgmcvof.supabase.co';
    var KEY_FALLBACK = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVrcGFwcXNzZ3N4aXJzZ21jdm9mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAyOTU5OTMsImV4cCI6MjA4NTg3MTk5M30.Le1gdE3HhmZ2gzMJF9hVhlZVsILmLd5GQgk87xC_dUY';
    var URL_BASE = ({{ s.supabase_url | json }} || URL_FALLBACK).trim();
    var KEY = ({{ s.supabase_anon_key | json }} || KEY_FALLBACK).trim();
    var ROWS = {{ s.rows }};
    var SPEED = {{ s.speed }};
    var CARD_W = {{ s.card_width }};
    var MAX = {{ s.max_photos }};
    var PROD_PREFIX = {{ '/products/' | json }};
    var DESIGN = {{ request.design_mode | json }};
    var RANDOM = {% if s.random_order == false %}false{% else %}true{% endif %};

    function placeholder(msg) {
      /* Section toujours visible ; on affiche un message d'état lisible dans la zone du mur. */
      root.style.display = '';
      wall.innerHTML = '<p class="rdc-mv__status">' + msg + '</p>';
    }

    var root = document.getElementById(UID);
    var wall = document.getElementById(UID + '-wall');
    var lb = document.getElementById(UID + '-lb');
    var lbImg = document.getElementById(UID + '-lb-img');
    var lbOverlay = document.getElementById(UID + '-lb-overlay');
    var lbCounter = document.getElementById(UID + '-lb-counter');
    var navPrev = document.getElementById(UID + '-lb-prev');
    var navNext = document.getElementById(UID + '-lb-next');
    var lbClose = lb.querySelector('.rdc-mv__lb-close');
    if (!root || !wall) return;

    if (!URL_BASE || !KEY) { placeholder("Mur communautaire — renseigne l'URL et la clé Supabase dans les réglages de la section."); return; }

    function esc(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    var photos = [];

    /* --- Lightbox (style galerie produit : overlay infos sur la photo + navigation) --- */
    var current = 0;

    function stars(n) {
      n = Math.max(0, Math.min(5, parseInt(n, 10) || 0));
      var html = '⭐'.repeat(n);
      for (var i = n; i < 5; i++) html += '<span class="rdc-mv__lb-star-off">⭐</span>';
      return html;
    }
    function buildOverlay(p) {
      var html = '';
      if (p.submitter_name) {
        html += '<div class="rdc-mv__lb-name">' + esc(p.submitter_name);
        if (p.shopify_product_handle) html += ' <span class="rdc-mv__lb-verified">✓ Avis vérifié · produit acheté</span>';
        html += '</div>';
      }
      if (p.rating_experience) html += '<div class="rdc-mv__lb-rating">Expérience ' + stars(p.rating_experience) + '</div>';
      if (p.rating_products) html += '<div class="rdc-mv__lb-rating">Produits ' + stars(p.rating_products) + '</div>';
      if (p.message) html += '<div class="rdc-mv__lb-msg">« ' + esc(p.message) + ' »</div>';
      if (p.submitter_instagram) {
        var h = String(p.submitter_instagram).replace('@', '');
        html += '<a class="rdc-mv__lb-prod" href="https://instagram.com/' + esc(h) + '" target="_blank" rel="noopener">@' + esc(h) + '</a>';
      }
      if (p.shopify_product_handle) html += '<a class="rdc-mv__lb-prod" href="' + PROD_PREFIX + esc(p.shopify_product_handle) + '">🛍 ' + esc(p.shopify_product_title || 'Voir le produit') + '</a>';
      return html;
    }
    function renderModal() {
      var p = photos[current];
      if (!p) return;
      lbImg.src = p.image_url;
      lbImg.alt = 'Photo de ' + (p.submitter_name || 'la communauté');
      lbOverlay.innerHTML = buildOverlay(p);
      var multi = photos.length > 1;
      lbCounter.textContent = (current + 1) + ' / ' + photos.length;
      lbCounter.style.display = multi ? '' : 'none';
      navPrev.style.display = multi ? '' : 'none';
      navNext.style.display = multi ? '' : 'none';
    }
    function openModal(idx) {
      current = idx;
      renderModal();
      lb.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      lb.classList.remove('is-open');
      lbImg.src = '';
      document.body.style.overflow = '';
    }
    function go(dir) {
      if (!photos.length) return;
      current = (current + dir + photos.length) % photos.length;
      renderModal();
    }
    navPrev.addEventListener('click', function(e) { e.stopPropagation(); go(-1); });
    navNext.addEventListener('click', function(e) { e.stopPropagation(); go(1); });
    lbClose.addEventListener('click', closeModal);
    lb.addEventListener('click', function(e) { if (e.target === lb) closeModal(); });
    document.addEventListener('keydown', function(e) {
      if (!lb.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeModal();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
    var touchX = null;
    lb.addEventListener('touchstart', function(e) { touchX = e.changedTouches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', function(e) {
      if (touchX === null) return;
      var dx = e.changedTouches[0].clientX - touchX; touchX = null;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
    }, { passive: true });

    function cardHtml(p, idx) {
      var nm = p.submitter_name ? '<div class="rdc-mv__name">' + esc(p.submitter_name) + '</div>' : '';
      return '<div class="rdc-mv__ph" data-idx="' + idx + '">' +
        '<img src="' + esc(p.image_url) + '" alt="' + esc(p.submitter_name || 'Photo communautaire') + '" loading="lazy">' + nm + '</div>';
    }

    function buildRow(list, duration, reverse) {
      /* Répète le jeu jusqu'à couvrir ~1.6× la largeur viewport pour une boucle sans couture. */
      var unit = CARD_W + 14;
      var target = Math.max(window.innerWidth * 1.6, unit * 6);
      var repeats = Math.max(1, Math.ceil(target / (list.length * unit)));
      var half = '';
      for (var r = 0; r < repeats; r++) {
        for (var i = 0; i < list.length; i++) { half += cardHtml(list[i], list[i]._idx); }
      }
      var style = 'animation: rdcMvScroll ' + duration + 's linear infinite;' + (reverse ? 'animation-direction:reverse;' : '');
      return '<div class="rdc-mv__row"><div class="rdc-mv__track" style="' + style + '">' + half + half + '</div></div>';
    }

    function render() {
      photos.forEach(function(p, i) { p._idx = i; });
      /* Répartition round-robin : chaque image n'apparaît que dans UNE rangée (pas de doublon haut/bas). */
      var html = '';
      var nbRows = Math.min(ROWS, photos.length) || 1;
      for (var r = 0; r < nbRows; r++) {
        var list = photos.filter(function(_p, i) { return i % nbRows === r; });
        if (!list.length) continue;
        html += buildRow(list, SPEED + r * 6, r % 2 === 1);
      }
      wall.innerHTML = html;
      wall.addEventListener('click', function(e) {
        var c = e.target.closest('.rdc-mv__ph');
        if (!c) return;
        var idx = parseInt(c.getAttribute('data-idx'), 10);
        if (photos[idx]) openModal(idx);
      });
    }

    var endpoint = URL_BASE.replace(/\/$/, '') +
      '/rest/v1/movement_wall_photos?select=image_url,submitter_name,submitter_instagram,shopify_product_handle,shopify_product_title,message,created_at,rating_experience,rating_products&order=created_at.desc&limit=' + MAX;

    fetch(endpoint, { headers: { 'apikey': KEY, 'Authorization': 'Bearer ' + KEY } })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        photos = (data || []).filter(function(p) { return p && p.image_url; });
        if (!photos.length) { placeholder('Aucune photo approuvée pour le moment. La section apparaîtra ici dès qu\'il y aura des photos.'); return; }
        if (RANDOM) {
          for (var k = photos.length - 1; k > 0; k--) {
            var j = Math.floor(Math.random() * (k + 1));
            var tmp = photos[k]; photos[k] = photos[j]; photos[j] = tmp;
          }
        }
        root.style.display = '';
        render();
      })
      .catch(function(err) {
        console.error('[rdc-mur-vivant]', err);
        placeholder('Impossible de charger les photos du mur (vérifie la connexion Supabase).');
      });
  })();
</script>

{% schema %}
{
  "name": "RDC — Mouvement vivant",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Ils nous portent" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Le mouvement est vivant" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Des aventuriers, partout en France, qui portent leur Fragment d'Histoire. Vous êtes le mouvement." },

    { "type": "header", "content": "Barre de stats" },
    { "type": "checkbox", "id": "show_stats", "label": "Afficher les stats", "default": true },
    { "type": "checkbox", "id": "show_stars", "label": "Afficher les étoiles (note)", "default": true },
    { "type": "text", "id": "stat_rating_label", "label": "Stat 1 — texte note", "default": "4,6/5 de moyenne" },
    { "type": "text", "id": "stat2_value", "label": "Stat 2 — chiffre", "default": "+5 000" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 — légende", "default": "clients conquis" },
    { "type": "text", "id": "stat3_value", "label": "Stat 3 — chiffre", "default": "+30/an" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 — légende", "default": "festivals en France" },

    { "type": "header", "content": "Carrousel" },
