{% schema %}
{
  "name": "Borne RDC v2",
  "settings": [
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond par défaut"
    },
    {
      "type": "header",
      "content": "Textes"
    },
    {
      "type": "text",
      "id": "welcome_title",
      "label": "Titre d'accueil",
      "default": "BORNE DE COMMANDE"
    },
    {
      "type": "text",
      "id": "welcome_subtitle",
      "label": "Sous-titre d'accueil",
      "default": "Comment souhaitez-vous explorer ?"
    },
    {
      "type": "text",
      "id": "btn_by_article",
      "label": "Bouton 'Par article'",
      "default": "Par type d'article"
    },
    {
      "type": "text",
      "id": "btn_by_illustration",
      "label": "Bouton 'Par illustration'",
      "default": "Par illustration"
    }
  ],
  "presets": [
    {
      "name": "Borne RDC v2"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Borne de commande v2 — Runes de Chêne
  Navigation : Accueil → (Par article | Par illustration) → Produits → Détail + Panier
{%- endcomment -%}

{%- comment -%} ========== DONNÉES LIQUID ========== {%- endcomment -%}

{%- comment -%} Récupérer tous les métaobjets {%- endcomment -%}
{%- assign all_produits_meta = shop.metaobjects.produits.values -%}
{%- assign all_illustrations = shop.metaobjects.illustrations.values -%}

{%- comment -%} Collecter les catégories uniques depuis les métaobjets Produits {%- endcomment -%}
{%- assign all_categories = '' -%}
{%- for pm in all_produits_meta -%}
  {%- if pm.categorie != blank -%}
    {%- assign cat_name = pm.categorie | strip -%}
    {%- unless all_categories contains cat_name -%}
      {%- if all_categories == '' -%}
        {%- assign all_categories = cat_name -%}
      {%- else -%}
        {%- assign all_categories = all_categories | append: '||' | append: cat_name -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign categories_array = all_categories | split: '||' -%}

{%- comment -%} Préparer les données JSON pour le JS {%- endcomment -%}
<script type="application/json" id="borne-produits-data">
[
  {%- for pm in all_produits_meta -%}
    {%- comment -%} Récupérer la collection liée {%- endcomment -%}
    {%- assign linked_collection = nil -%}
    {%- if pm.collection != blank -%}
      {%- if pm.collection.value -%}
        {%- assign linked_collection = pm.collection.value -%}
      {%- else -%}
        {%- assign linked_collection = pm.collection -%}
      {%- endif -%}
    {%- endif -%}
    {
      "nom": {{ pm.nom | json }},
      "handle": {{ pm.system.handle | json }},
      "image": {% if pm.image != blank %}"{{ pm.image | image_url: width: 400 }}"{% else %}null{% endif %},
      "icone": {% if pm.icone != blank %}"{{ pm.icone | image_url: width: 120 }}"{% else %}null{% endif %},
      "label": {{ pm.label | default: pm.nom | json }},
      "categorie": {{ pm.categorie | json }},
      "type": {{ pm.type | json }},
      "coupe": {{ pm.coupe | json }},
      "tissu": {{ pm.tissu | json }},
      "force_de_vente": {{ pm.force_de_vente | json }},
      "description": {{ pm.description | metafield_text | strip_html | truncate: 300 | json }},
      "collection_handle": {% if linked_collection %}"{{ linked_collection.handle }}"{% else %}null{% endif %},
      "collection_url": {% if linked_collection %}"{{ linked_collection.url }}"{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
</script>

<script type="application/json" id="borne-illustrations-data">
[
  {%- for illus in all_illustrations -%}
    {%- assign illus_collection = nil -%}
    {%- if illus.collection != blank -%}
      {%- if illus.collection.value -%}
        {%- assign illus_collection = illus.collection.value -%}
      {%- else -%}
        {%- assign illus_collection = illus.collection -%}
      {%- endif -%}
    {%- endif -%}
    {
      "nom": {{ illus.nom | json }},
      "handle": {{ illus.system.handle | json }},
      "resume": {{ illus.resume | json }},
      "description_borne": {{ illus.description_borne | metafield_text | strip_html | truncate: 300 | json }},
      "image_clair": {% if illus.image_pour_fond_clair != blank %}"{{ illus.image_pour_fond_clair | image_url: width: 600 }}"{% else %}null{% endif %},
      "image_sombre": {% if illus.image_pour_fond_sombre != blank %}"{{ illus.image_pour_fond_sombre | image_url: width: 600 }}"{% else %}null{% endif %},
      "image_fond": {% if illus.image_fond_de_fragment != blank %}"{{ illus.image_fond_de_fragment | image_url: width: 1920 }}"{% else %}null{% endif %},
      "artiste": {% if illus.artiste.value.nom.value != blank %}{{ illus.artiste.value.nom.value | json }}{% else %}null{% endif %},
      "collection_handle": {% if illus_collection %}"{{ illus_collection.handle }}"{% else %}null{% endif %},
      "collection_url": {% if illus_collection %}"{{ illus_collection.url }}"{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
</script>

{%- comment -%} ========== HTML ========== {%- endcomment -%}

<div class="rdc-borne" id="rdc-borne" data-section-id="{{ section.id }}">

  {%- comment -%} Image de fond dynamique {%- endcomment -%}
  <div class="rdc-borne__bg">
    <div class="rdc-borne__bg-default rdc-borne__bg-layer active"
      {% if section.settings.background_image != blank %}
        style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');"
      {% else %}
        style="background-image: url('{{ "explore_fond_default.webp" | asset_url }}');"
      {% endif %}
    ></div>
    <div class="rdc-borne__bg-dynamic rdc-borne__bg-layer"></div>
  </div>

  {%- comment -%} Bouton retour {%- endcomment -%}
  <button class="rdc-borne__back-button" data-action="back" aria-label="Retour">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  {%- comment -%} Bouton panier flottant — ouvre le cart drawer natif Shopify {%- endcomment -%}
  <button class="rdc-borne__cart-button" data-action="open-native-cart">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <span class="rdc-borne__cart-count">0</span>
  </button>

  {%- comment -%} ===== POPUP CONFIRMATION ===== {%- endcomment -%}
  <div class="rdc-borne__popup" id="cart-confirmation-popup" data-visible="false">
    <div class="rdc-borne__popup-content">
      <div class="rdc-borne__popup-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <h3 class="rdc-borne__popup-title">Ajouté au panier</h3>
      <p class="rdc-borne__popup-product-name"></p>
      <div class="rdc-borne__popup-buttons">
        <button class="rdc-borne__popup-btn rdc-borne__popup-btn--primary" data-action="continue-shopping">Continuer mes achats</button>
        <button class="rdc-borne__popup-btn rdc-borne__popup-btn--secondary" data-action="view-cart">Voir le panier</button>
      </div>
    </div>
  </div>

  {%- comment -%} ===== ÉCRAN 0 : ACCUEIL ===== {%- endcomment -%}
  <div class="rdc-borne__screen" data-screen="0" data-active="true">
    <div class="rdc-borne__screen-inner rdc-borne__screen-welcome">
      <h1 class="rdc-borne__welcome-title">{{ section.settings.welcome_title }}</h1>
      <p class="rdc-borne__welcome-subtitle">{{ section.settings.welcome_subtitle }}</p>
      <div class="rdc-borne__welcome-choices">
        <button class="rdc-borne__choice-btn" data-choice="article">
          <span class="rdc-borne__choice-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </span>
          <span class="rdc-borne__choice-label">{{ section.settings.btn_by_article }}</span>
        </button>
        <button class="rdc-borne__choice-btn" data-choice="illustration">
          <span class="rdc-borne__choice-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
          </span>
          <span class="rdc-borne__choice-label">{{ section.settings.btn_by_illustration }}</span>
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} ===== ÉCRAN 1a : CATÉGORIES (par article) ===== {%- endcomment -%}
  <div class="rdc-borne__screen" data-screen="1a" data-active="false">
    <div class="rdc-borne__screen-inner">
      <h1 class="rdc-borne__screen-title">Choisissez une catégorie</h1>
      <div class="rdc-borne__grid rdc-borne__categories-grid">
        {%- for cat in categories_array -%}
          {%- comment -%} Trouver la première icône de cette catégorie {%- endcomment -%}
          {%- assign cat_icon = nil -%}
          {%- assign cat_image = nil -%}
          {%- for pm in all_produits_meta -%}
            {%- assign pm_cat = pm.categorie | strip -%}
            {%- if pm_cat == cat -%}
              {%- if cat_icon == nil and pm.icone != blank -%}
                {%- assign cat_icon = pm.icone -%}
              {%- endif -%}
              {%- if cat_image == nil and pm.image != blank -%}
                {%- assign cat_image = pm.image -%}
              {%- endif -%}
              {%- if cat_icon != nil and cat_image != nil -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <button class="rdc-borne__category-card" data-category="{{ cat }}">
            <div class="rdc-borne__category-card-img">
              {%- if cat_image != nil -%}
                <img src="{{ cat_image | image_url: width: 400 }}" alt="{{ cat }}" loading="lazy">
              {%- else -%}
                <div class="rdc-borne__placeholder"></div>
              {%- endif -%}
            </div>
            <span class="rdc-borne__category-card-label">{{ cat }}</span>
          </button>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ===== ÉCRAN 1b : ILLUSTRATIONS (par illustration) ===== {%- endcomment -%}
  <div class="rdc-borne__screen" data-screen="1b" data-active="false">
    <div class="rdc-borne__screen-inner">
      <h1 class="rdc-borne__screen-title">Choisissez une illustration</h1>
      <div class="rdc-borne__grid rdc-borne__illustrations-grid">
        {%- for illus in all_illustrations -%}
          <button class="rdc-borne__illustration-card" 
            data-illustration-handle="{{ illus.system.handle }}"
            data-bg-image="{% if illus.image_fond_de_fragment != blank %}{{ illus.image_fond_de_fragment | image_url: width: 1920 }}{% endif %}"
          >
            <div class="rdc-borne__illustration-card-img">
              {%- if illus.image_pour_fond_clair != blank -%}
                <img src="{{ illus.image_pour_fond_clair | image_url: width: 400 }}" alt="{{ illus.nom }}" loading="lazy">
              {%- else -%}
                <div class="rdc-borne__placeholder"></div>
              {%- endif -%}
            </div>
            <div class="rdc-borne__illustration-card-info">
              <span class="rdc-borne__illustration-card-name">{{ illus.nom }}</span>
              {%- if illus.resume != blank -%}
                <span class="rdc-borne__illustration-card-summary">« {{ illus.resume }} »</span>
              {%- endif -%}
              {%- if illus.artiste.value.nom.value != blank -%}
                <span class="rdc-borne__illustration-card-artist">{{ illus.artiste.value.nom.value }}</span>
              {%- endif -%}
            </div>
          </button>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ===== ÉCRAN 2 : PRODUITS (métaobjets) ===== {%- endcomment -%}
  <div class="rdc-borne__screen" data-screen="2" data-active="false">
    <div class="rdc-borne__screen-inner">
      <h1 class="rdc-borne__screen-title rdc-borne__products-title">Choisissez un article</h1>
      {%- comment -%} Description de l'illustration sélectionnée (visible uniquement en mode illustration) {%- endcomment -%}
      <p class="rdc-borne__illustration-desc" style="display:none;"></p>
      <div class="rdc-borne__grid rdc-borne__produits-grid">
        {%- for pm in all_produits_meta -%}
          <button class="rdc-borne__produit-card" 
            data-produit-handle="{{ pm.system.handle }}"
            data-categorie="{{ pm.categorie | strip }}"
            data-collection-handle="{% if pm.collection.value %}{{ pm.collection.value.handle }}{% elsif pm.collection %}{{ pm.collection.handle }}{% endif %}"
          >
            <div class="rdc-borne__produit-card-img">
              {%- if pm.icone != blank -%}
                <img src="{{ pm.icone | image_url: width: 200 }}" alt="{{ pm.label | default: pm.nom }}" loading="lazy">
              {%- elsif pm.image != blank -%}
                <img src="{{ pm.image | image_url: width: 300 }}" alt="{{ pm.label | default: pm.nom }}" loading="lazy">
              {%- else -%}
                <div class="rdc-borne__placeholder"></div>
              {%- endif -%}
            </div>
            <div class="rdc-borne__produit-card-info">
              <span class="rdc-borne__produit-card-label">{{ pm.label | default: pm.nom }}</span>
              {%- if pm.type != blank -%}
                <span class="rdc-borne__produit-card-type">{{ pm.type }}</span>
              {%- endif -%}
              {%- if pm.force_de_vente != blank -%}
                <span class="rdc-borne__produit-card-pitch">{{ pm.force_de_vente }}</span>
              {%- endif -%}
            </div>
          </button>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ===== ÉCRAN 3 : DÉTAIL PRODUIT (chargé dynamiquement) ===== {%- endcomment -%}
  {%- comment -%} 
    On pré-rend les produits de chaque collection liée aux métaobjets.
    Pour éviter les doublons, on track les handles déjà rendus.
  {%- endcomment -%}
  <div class="rdc-borne__screen" data-screen="3" data-active="false">
    <div class="rdc-borne__screen-inner rdc-borne__detail-screen">
      {%- comment -%} Titre dynamique {%- endcomment -%}
      <h1 class="rdc-borne__screen-title rdc-borne__detail-title"></h1>

      {%- comment -%} Grille de produits Shopify de la collection sélectionnée {%- endcomment -%}
      {%- assign rendered_collections = '' -%}
      {%- for pm in all_produits_meta -%}
        {%- assign col = nil -%}
        {%- if pm.collection.value -%}
          {%- assign col = pm.collection.value -%}
        {%- elsif pm.collection -%}
          {%- assign col = pm.collection -%}
        {%- endif -%}
        {%- if col != blank -%}
          {%- unless rendered_collections contains col.handle -%}
            {%- assign rendered_collections = rendered_collections | append: col.handle | append: ',' -%}
            <div class="rdc-borne__shopify-products" data-collection="{{ col.handle }}" style="display:none;">
              {%- paginate col.products by 50 -%}
                {%- for product in col.products -%}
                  <div class="rdc-borne__shop-product" data-product-handle="{{ product.handle }}">
                    <div class="rdc-borne__shop-product-img">
                      <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}" loading="lazy">
                    </div>
                    <div class="rdc-borne__shop-product-info">
                      <h3 class="rdc-borne__shop-product-title">{{ product.title }}</h3>
                      {%- comment -%} Swatches couleur aperçu (système natif Shopify) {%- endcomment -%}
                      {%- for option in product.options_with_values -%}
                        {%- if option.name == 'Couleur' or option.name == 'Couleurs' -%}
                          <div class="rdc-borne__mini-swatches">
                            {%- for val in option.values limit: 5 -%}
                              <span class="rdc-borne__mini-swatch" title="{{ val.name }}">
                                {%- if val.swatch.image -%}
                                  <img src="{{ val.swatch.image | image_url: width: 40 }}" alt="{{ val.name }}" loading="lazy">
                                {%- elsif val.swatch.color -%}
                                  <span class="rdc-borne__mini-swatch-color" style="background: rgb({{ val.swatch.color.rgb }});"></span>
                                {%- else -%}
                                  <span class="rdc-borne__mini-swatch-fallback" data-color="{{ val.name | handleize }}"></span>
                                {%- endif -%}
                              </span>
                            {%- endfor -%}
                            {%- if option.values.size > 5 -%}
                              <span class="rdc-borne__mini-swatch-more">+{{ option.values.size | minus: 5 }}</span>
                            {%- endif -%}
                          </div>
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <div class="rdc-borne__shop-product-price">
                        {%- if product.compare_at_price > product.price -%}
                          <span class="rdc-borne__price-compare">{{ product.compare_at_price | money }}</span>
                        {%- endif -%}
                        <span class="rdc-borne__price-current{% if product.compare_at_price > product.price %} rdc-borne__price-sale{% endif %}">{{ product.price | money }}</span>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              {%- endpaginate -%}
            </div>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Aussi rendre les collections liées aux illustrations {%- endcomment -%}
      {%- for illus in all_illustrations -%}
        {%- assign icol = nil -%}
        {%- if illus.collection.value -%}
          {%- assign icol = illus.collection.value -%}
        {%- elsif illus.collection -%}
          {%- assign icol = illus.collection -%}
        {%- endif -%}
        {%- if icol != blank -%}
          {%- unless rendered_collections contains icol.handle -%}
            {%- assign rendered_collections = rendered_collections | append: icol.handle | append: ',' -%}
            <div class="rdc-borne__shopify-products" data-collection="{{ icol.handle }}" style="display:none;">
              {%- paginate icol.products by 50 -%}
                {%- for product in icol.products -%}
                  <div class="rdc-borne__shop-product" data-product-handle="{{ product.handle }}">
                    <div class="rdc-borne__shop-product-img">
                      <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}" loading="lazy">
                    </div>
                    <div class="rdc-borne__shop-product-info">
                      <h3 class="rdc-borne__shop-product-title">{{ product.title }}</h3>
                      {%- for option in product.options_with_values -%}
                        {%- if option.name == 'Couleur' or option.name == 'Couleurs' -%}
                          <div class="rdc-borne__mini-swatches">
                            {%- for val in option.values limit: 5 -%}
                              <span class="rdc-borne__mini-swatch" title="{{ val.name }}">
                                {%- if val.swatch.image -%}
                                  <img src="{{ val.swatch.image | image_url: width: 40 }}" alt="{{ val.name }}" loading="lazy">
                                {%- elsif val.swatch.color -%}
                                  <span class="rdc-borne__mini-swatch-color" style="background: rgb({{ val.swatch.color.rgb }});"></span>
                                {%- else -%}
                                  <span class="rdc-borne__mini-swatch-fallback" data-color="{{ val.name | handleize }}"></span>
                                {%- endif -%}
                              </span>
                            {%- endfor -%}
                            {%- if option.values.size > 5 -%}
                              <span class="rdc-borne__mini-swatch-more">+{{ option.values.size | minus: 5 }}</span>
                            {%- endif -%}
                          </div>
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <div class="rdc-borne__shop-product-price">
                        {%- if product.compare_at_price > product.price -%}
                          <span class="rdc-borne__price-compare">{{ product.compare_at_price | money }}</span>
                        {%- endif -%}
                        <span class="rdc-borne__price-current{% if product.compare_at_price > product.price %} rdc-borne__price-sale{% endif %}">{{ product.price | money }}</span>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              {%- endpaginate -%}
            </div>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ===== ÉCRAN 4 : DÉTAIL PRODUIT SHOPIFY (variantes) ===== {%- endcomment -%}
  <div class="rdc-borne__screen" data-screen="4" data-active="false">
    <div class="rdc-borne__screen-inner rdc-borne__variant-screen">
      {%- assign rendered_products = '' -%}
      {%- for pm in all_produits_meta -%}
        {%- assign col = nil -%}
        {%- if pm.collection.value -%}
          {%- assign col = pm.collection.value -%}
        {%- elsif pm.collection -%}
          {%- assign col = pm.collection -%}
        {%- endif -%}
        {%- if col != blank -%}
          {%- for product in col.products -%}
            {%- unless rendered_products contains product.handle -%}
              {%- assign rendered_products = rendered_products | append: product.handle | append: ',' -%}
              <div class="rdc-borne__product-detail" data-product-handle="{{ product.handle }}" style="display:none;">
                <div class="rdc-borne__detail-top">
                  <div class="rdc-borne__detail-image">
                    <img class="rdc-borne__detail-main-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
                  </div>
                  <div class="rdc-borne__detail-info">
                    <h2 class="rdc-borne__detail-product-title">{{ product.title }}</h2>
                    <div class="rdc-borne__detail-price">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="rdc-borne__price-compare">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                      <span class="rdc-borne__price-current{% if product.compare_at_price > product.price %} rdc-borne__price-sale{% endif %}">{{ product.price | money }}</span>
                    </div>
                    <div class="rdc-borne__detail-selected">
                      <span class="rdc-borne__selected-color-label"></span>
                      <span class="rdc-borne__selected-size-label"></span>
                    </div>
                  </div>
                </div>

                {%- if product.variants.size > 1 -%}
                  {%- for option in product.options_with_values -%}
                    {%- assign option_index = forloop.index0 -%}
                    {%- if option.name == 'Couleur' or option.name == 'Couleurs' -%}
                      <div class="rdc-borne__option-group">
                        <h3 class="rdc-borne__option-label">Couleur</h3>
                        <div class="rdc-borne__swatches rdc-borne__swatches--color">
                          {%- for value in option.values -%}
                            {%- assign matching_variant = nil -%}
                            {%- for variant in product.variants -%}
                              {%- if variant.options[option_index] == value.name -%}
                                {%- assign matching_variant = variant -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}

                            {%- assign variant_image = nil -%}
                            {%- for variant in product.variants -%}
                              {%- if variant.options[option_index] == value.name and variant.image -%}
                                {%- assign variant_image = variant.image -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- unless variant_image -%}
                              {%- assign variant_image = product.featured_image -%}
                            {%- endunless -%}

                            <button class="rdc-borne__swatch rdc-borne__swatch--color{% unless matching_variant.available %} sold-out{% endunless %}"
                              {% unless matching_variant.available %}disabled{% endunless %}
                              data-color="{{ value.name | handleize }}"
                              data-color-name="{{ value.name }}"
                              data-variant-id="{{ matching_variant.id }}"
                              data-image-url="{{ variant_image | image_url: width: 600 }}"
                            >
                              {%- if value.swatch.image -%}
                                <img src="{{ value.swatch.image | image_url: width: 60 }}" alt="{{ value.name }}" loading="lazy">
                              {%- elsif value.swatch.color -%}
                                <span class="rdc-borne__swatch-color" style="background: rgb({{ value.swatch.color.rgb }});"></span>
                              {%- else -%}
                                <span class="rdc-borne__swatch-fallback" data-color="{{ value.name | handleize }}"></span>
                              {%- endif -%}
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- elsif option.name == 'Taille' -%}
                      <div class="rdc-borne__option-group">
                        <h3 class="rdc-borne__option-label">Taille</h3>
                        <div class="rdc-borne__swatches rdc-borne__swatches--size">
                          {%- assign color_option_index = 0 -%}
                          {%- assign size_option_index = 1 -%}
                          {%- for product_option in product.options -%}
                            {%- if product_option == 'Couleur' or product_option == 'Couleurs' -%}
                              {%- assign color_option_index = forloop.index0 -%}
                            {%- endif -%}
                            {%- if product_option == 'Taille' -%}
                              {%- assign size_option_index = forloop.index0 -%}
                            {%- endif -%}
                          {%- endfor -%}

                          {%- for value in option.values -%}
                            {%- assign available_colors_for_size = '' -%}
                            {%- assign variant_ids_for_size = '' -%}
                            {%- for variant in product.variants -%}
                              {%- if variant.options[size_option_index] == value.name and variant.available -%}
                                {%- assign color_value = variant.options[color_option_index] | handleize -%}
                                {%- assign available_colors_for_size = available_colors_for_size | append: ',' | append: color_value -%}
                                {%- assign variant_ids_for_size = variant_ids_for_size | append: ',' | append: variant.id | append: ':' | append: color_value -%}
                              {%- endif -%}
                            {%- endfor -%}
                            <button class="rdc-borne__swatch rdc-borne__swatch--size"
                              data-size="{{ value.name | escape }}"
                              data-available-colors="{{ available_colors_for_size }}"
                              data-variant-ids="{{ variant_ids_for_size }}"
                            >
                              {{ value.name }}
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}

                <button class="rdc-borne__add-to-cart" data-variant-id="{{ product.first_available_variant.id }}">
                  Ajouter au panier
                </button>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Aussi rendre les produits des collections d'illustrations {%- endcomment -%}
      {%- for illus in all_illustrations -%}
        {%- assign icol = nil -%}
        {%- if illus.collection.value -%}
          {%- assign icol = illus.collection.value -%}
        {%- elsif illus.collection -%}
          {%- assign icol = illus.collection -%}
        {%- endif -%}
        {%- if icol != blank -%}
          {%- for product in icol.products -%}
            {%- unless rendered_products contains product.handle -%}
              {%- assign rendered_products = rendered_products | append: product.handle | append: ',' -%}
              <div class="rdc-borne__product-detail" data-product-handle="{{ product.handle }}" style="display:none;">
                <div class="rdc-borne__detail-top">
                  <div class="rdc-borne__detail-image">
                    <img class="rdc-borne__detail-main-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
                  </div>
                  <div class="rdc-borne__detail-info">
                    <h2 class="rdc-borne__detail-product-title">{{ product.title }}</h2>
                    <div class="rdc-borne__detail-price">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="rdc-borne__price-compare">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                      <span class="rdc-borne__price-current{% if product.compare_at_price > product.price %} rdc-borne__price-sale{% endif %}">{{ product.price | money }}</span>
                    </div>
                    <div class="rdc-borne__detail-selected">
                      <span class="rdc-borne__selected-color-label"></span>
                      <span class="rdc-borne__selected-size-label"></span>
                    </div>
                  </div>
                </div>

                {%- if product.variants.size > 1 -%}
                  {%- for option in product.options_with_values -%}
                    {%- assign option_index = forloop.index0 -%}
                    {%- if option.name == 'Couleur' or option.name == 'Couleurs' -%}
                      <div class="rdc-borne__option-group">
                        <h3 class="rdc-borne__option-label">Couleur</h3>
                        <div class="rdc-borne__swatches rdc-borne__swatches--color">
                          {%- for value in option.values -%}
                            {%- assign matching_variant = nil -%}
                            {%- for variant in product.variants -%}
                              {%- if variant.options[option_index] == value.name -%}
                                {%- assign matching_variant = variant -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}

                            {%- assign variant_image = nil -%}
                            {%- for variant in product.variants -%}
                              {%- if variant.options[option_index] == value.name and variant.image -%}
                                {%- assign variant_image = variant.image -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- unless variant_image -%}
                              {%- assign variant_image = product.featured_image -%}
                            {%- endunless -%}

                            <button class="rdc-borne__swatch rdc-borne__swatch--color{% unless matching_variant.available %} sold-out{% endunless %}"
                              {% unless matching_variant.available %}disabled{% endunless %}
                              data-color="{{ value.name | handleize }}"
                              data-color-name="{{ value.name }}"
                              data-variant-id="{{ matching_variant.id }}"
                              data-image-url="{{ variant_image | image_url: width: 600 }}"
                            >
                              {%- if value.swatch.image -%}
                                <img src="{{ value.swatch.image | image_url: width: 60 }}" alt="{{ value.name }}" loading="lazy">
                              {%- elsif value.swatch.color -%}
                                <span class="rdc-borne__swatch-color" style="background: rgb({{ value.swatch.color.rgb }});"></span>
                              {%- else -%}
                                <span class="rdc-borne__swatch-fallback" data-color="{{ value.name | handleize }}"></span>
                              {%- endif -%}
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- elsif option.name == 'Taille' -%}
                      <div class="rdc-borne__option-group">
                        <h3 class="rdc-borne__option-label">Taille</h3>
                        <div class="rdc-borne__swatches rdc-borne__swatches--size">
                          {%- assign color_option_index = 0 -%}
                          {%- assign size_option_index = 1 -%}
                          {%- for product_option in product.options -%}
                            {%- if product_option == 'Couleur' or product_option == 'Couleurs' -%}
                              {%- assign color_option_index = forloop.index0 -%}
                            {%- endif -%}
                            {%- if product_option == 'Taille' -%}
                              {%- assign size_option_index = forloop.index0 -%}
                            {%- endif -%}
                          {%- endfor -%}

                          {%- for value in option.values -%}
                            {%- assign available_colors_for_size = '' -%}
                            {%- assign variant_ids_for_size = '' -%}
                            {%- for variant in product.variants -%}
                              {%- if variant.options[size_option_index] == value.name and variant.available -%}
                                {%- assign color_value = variant.options[color_option_index] | handleize -%}
                                {%- assign available_colors_for_size = available_colors_for_size | append: ',' | append: color_value -%}
                                {%- assign variant_ids_for_size = variant_ids_for_size | append: ',' | append: variant.id | append: ':' | append: color_value -%}
                              {%- endif -%}
                            {%- endfor -%}
                            <button class="rdc-borne__swatch rdc-borne__swatch--size"
                              data-size="{{ value.name | escape }}"
                              data-available-colors="{{ available_colors_for_size }}"
                              data-variant-ids="{{ variant_ids_for_size }}"
                            >
                              {{ value.name }}
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}

                <button class="rdc-borne__add-to-cart" data-variant-id="{{ product.first_available_variant.id }}">
                  Ajouter au panier
                </button>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

