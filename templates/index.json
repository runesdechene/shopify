        "text_ADm7eH": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h2>Qui se bat pour rendre au monde <br/>sa mémoire & son souffle</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
